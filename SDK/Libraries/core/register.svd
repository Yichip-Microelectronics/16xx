								<name>tx_byte3</name>
								<description>tx data byte 0</description>
								<bitRange>[31:24]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--tx_data_w1-->
					<register>
						<name>tx_data_w1</name>
						<description>* tx_data_w1 *</description>
						<addressOffset>0x6c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
