								<name>half_en</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--nec_wptr-->
					<register>
						<name>nec_wptr</name>
						<description>* nec_wptr *</description>
						<addressOffset>0x10</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>nec_wptr</name>
								<description>rx:nec write pointer\ntx:nec read pointer</description>
								<bitRange>[17:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--nec_items-->
					<register>
						<name>nec_items</name>
						<description>* nec_items *</description>
						<addressOffset>0x14</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>nec_items</name>
								<description>nec buffer items \nrx: 接收到个数\ntx: remain</description>
								<bitRange>[17:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--nec_status-->
					<register>
						<name>nec_status</name>
						<description>* nec_status *</description>
						<addressOffset>0x18</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>done</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>half_done</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--CORE_AES-->
			<peripheral>
				<name>CORE_AES</name>
				<version>1.0</version>
				<description>CORE_AES</description>
				<groupName>CORE_AES</groupName>
				<baseAddress>0x8480</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x40</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--aes_ctrl-->
					<register>
						<name>aes_ctrl</name>
						<description>* aes_ctrl *</description>
						<addressOffset>0x0</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>key_dword</name>
								<description>1:key pointer is dword a\nligned</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>data_dword</name>
								<description>1:data pointer is dword \naligned</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>mode</name>
								<description>0=ecb,1=cbc mode, 2=tx(s\ntore mic), 3=rx(check mic)</description>
								<bitRange>[3:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>endian</name>
								<description>1:big endian</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>mic_len</name>
								<description>0:4bytes 1:8bytes 2:12by\ntes 3:16bytes</description>
								<bitRange>[6:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>key_type</name>
								<description>0:from memory\n1:from regext[7:4]</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--aes_data_len-->
					<register>
						<name>aes_data_len</name>
						<description>* aes_data_len *</description>
						<addressOffset>0x1</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>aes_data_len</name>
								<description>aes data in bytes</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--aes_cmd-->
					<register>
						<name>aes_cmd</name>
						<description>* aes_cmd *</description>
						<addressOffset>0x2</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>aes_cmd</name>
								<description>1: start aes, 2,init iv,\n 3: clear interrupt,4:clear \niv</description>
								<bitRange>[2:0]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--aes_status-->
					<register>
						<name>aes_status</name>
						<description>* aes_status *</description>
						<addressOffset>0x3</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>aes_data_valid</name>
								<description>aes data valid</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>mic_ok</name>
								<description>mic is ok</description>
								<bitRange>[1:1]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>mic_done</name>
								<description>mic  done</description>
								<bitRange>[2:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>current calc data done</name>
								<description>nan</description>
								<bitRange>[3:3]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--aes_key_addr-->
					<register>
						<name>aes_key_addr</name>
						<description>* aes_key_addr *</description>
						<addressOffset>0x4</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>aes_key_addr</name>
								<description>aes encryption key point\ner</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--aes_data_addr-->
					<register>
						<name>aes_data_addr</name>
						<description>* aes_data_addr *</description>
						<addressOffset>0x8</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>aes_data_addr</name>
								<description>aes encryption data inpu\nt pointer</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--aes_xor_addr-->
					<register>
						<name>aes_xor_addr</name>
						<description>* aes_xor_addr *</description>
						<addressOffset>0xc</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>aes_xor_addr</name>
								<description>aes encryption xor data \ninput pointer</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--aes_ccm_addr-->
					<register>
						<name>aes_ccm_addr</name>
						<description>* aes_ccm_addr *</description>
						<addressOffset>0x10</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>aes_ccm_addr</name>
								<description>aes encryption xor data \noutput pointer ( xor data | \nmic data)</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--aes_sdata_len-->
					<register>
						<name>aes_sdata_len</name>
						<description>* aes_sdata_len *</description>
						<addressOffset>0x14</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>aes_sdata_len</name>
								<description>aes current calc data le\nn</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--aes_mic_result-->
					<register>
						<dim>16</dim>
						<dimIncrement>1</dimIncrement>
						<name>aes_mic_result[%s]</name>
						<description>* aes_mic_result *</description>
						<addressOffset>0x20</addressOffset>
						<size>8</size>
					</register>
					<!--aes_result-->
					<register>
						<dim>16</dim>
						<dimIncrement>1</dimIncrement>
						<name>aes_result[%s]</name>
						<description>* aes_result *</description>
						<addressOffset>0x30</addressOffset>
						<size>8</size>
					</register>
				</registers>
			</peripheral>
			<!--CORE_UARTC-->
			<peripheral derivedFrom= "CORE_UARTA">
				<name>CORE_UARTC</name>
				<baseAddress>0x8500</baseAddress>
			</peripheral derivedFrom= "CORE_UARTA">
			<!--CORE_UARTD-->
			<peripheral derivedFrom= "CORE_UARTA">
				<name>CORE_UARTD</name>
				<baseAddress>0x8540</baseAddress>
			</peripheral derivedFrom= "CORE_UARTA">
			<!--CORE_USB-->
			<peripheral>
				<name>CORE_USB</name>
				<version>1.0</version>
				<description>CORE_USB</description>
				<groupName>CORE_USB</groupName>
				<baseAddress>0x8600</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x5c</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--ctrl-->
					<register>
						<name>ctrl</name>
						<description>* ctrl *</description>
						<addressOffset>0x0</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ctrl</name>
								<description>[0] enable iso for endpo\nint 2 out \n[1] enable iso for endpoint \n2 in \n[3:2] usb pad bias control \n[4] enable usb function \n[5] 1:full speed 12m, 0:low \nspeed 1.5m \n[6] resume device \n[7] endpoint wakeup enable</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--addr-->
					<register>
						<name>addr</name>
						<description>* addr *</description>
						<addressOffset>0x1</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>addr</name>
								<description>usb address </description>
								<bitRange>[6:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dis_broadcast</name>
								<description>disable broadcast(addres\ns 0) packet receive</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--host_md-->
					<register>
						<name>host_md</name>
						<description>* host_md *</description>
						<addressOffset>0x2</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>host_md</name>
								<description>host mode </description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rst</name>
								<description>reset device in host mod\ne</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>sof_en</name>
								<description>sof enable</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dma_en</name>
								<description>dma enable</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>sof_win</name>
								<description>sof window</description>
								<bitRange>[6:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dp_pu1p5</name>
								<description>d+ pullup 1.5k</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--dp_pu2p7-->
					<register>
						<name>dp_pu2p7</name>
						<description>* dp_pu2p7 *</description>
						<addressOffset>0x3</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>dp_pu2p7</name>
								<description>d+ pullup 2.7k</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dp_pd</name>
								<description>d+ pulldown </description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dn_pd</name>
								<description>d- pulldown </description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dn_pu</name>
								<description>d- pullup</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--usb_irq_mask-->
					<register>
						<name>usb_irq_mask</name>
						<description>* usb_irq_mask *</description>
						<addressOffset>0x8</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>mask</name>
								<description>set 1 to mask correspoin\nding irq. see irq status for\n bit detail   </description>
								<bitRange>[12:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--usb_epmap-->
					<register>
						<name>usb_epmap</name>
						<description>* usb_epmap *</description>
						<addressOffset>0x1c</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ep1</name>
								<description>endpoint 1 ep value</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ep2</name>
								<description>endpoint 2 ep value</description>
								<bitRange>[7:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ep3</name>
								<description>endpoint 3 ep value</description>
								<bitRange>[11:8]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--usb_trig-->
					<register>
						<name>usb_trig</name>
						<description>* usb_trig *</description>
						<addressOffset>0x20</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ep_tx</name>
								<description>start tx of endpoint 0-3</description>
								<bitRange>[3:0]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>rst_udc</name>
								<description>udc reset</description>
								<bitRange>[4:4]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>rst_dpll</name>
								<description>dpll reset</description>
								<bitRange>[5:5]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>rst_rxcnt</name>
								<description>rx counter reset</description>
								<bitRange>[6:6]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>rst_sof</name>
								<description>sof counter reset</description>
								<bitRange>[7:7]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--reply0-->
					<register>
						<name>reply0</name>
						<description>* reply0 *</description>
						<addressOffset>0x21</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>reply0</name>
								<description>endpoint 3-0 reply zero \nlength packet to host, 0:in,\n 1:out</description>
								<bitRange>[7:0]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--set_stall_ep0-->
					<register>
						<name>set_stall_ep0</name>
						<description>* set_stall_ep0 *</description>
						<addressOffset>0x22</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>set_stall_ep0</name>
								<description>set endpoint 0 to stall</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>set_stall_ep1_in</name>
								<description>set endpoint 1 in to sta\nll</description>
								<bitRange>[1:1]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>set_stall_ep1_out</name>
								<description>set endpoint 1 out to st\nall</description>
								<bitRange>[2:2]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>set_stall_ep2_in</name>
								<description>set endpoint 2 in to sta\nll</description>
								<bitRange>[3:3]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>set_stall_ep2_out</name>
								<description>set endpoint 2 out to st\nall</description>
								<bitRange>[4:4]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>set_stall_ep3_in</name>
								<description>set endpoint 3 in to sta\nll</description>
								<bitRange>[5:5]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>set_stall_ep3_out</name>
								<description>set endpoint 3 out to st\nall </description>
								<bitRange>[6:6]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>host_md</name>
								<description>host mode start</description>
								<bitRange>[7:7]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--clr_ep0-->
					<register>
						<name>clr_ep0</name>
						<description>* clr_ep0 *</description>
						<addressOffset>0x23</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>clr_ep0</name>
								<description>clear endpoint 0 to data\n0</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>clr_ep1_out</name>
								<description>clear endpoint 1 out to \ndata0</description>
								<bitRange>[1:1]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>clr_ep1_in</name>
								<description>clear endpoint 1 in to d\nata0</description>
								<bitRange>[2:2]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>clr_ep2_out</name>
								<description>clear endpoint 2 out to \ndata0</description>
								<bitRange>[3:3]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>clr_ep2_in</name>
								<description>clear endpoint 2 in to d\nata0</description>
								<bitRange>[4:4]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>clr_ep3_out</name>
								<description>clear endpoint 3 out to \ndata0</description>
								<bitRange>[5:5]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>clr_ep3_in</name>
								<description>clear endpoint 3 in to d\nata0</description>
								<bitRange>[6:6]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>rst_ckcnt</name>
								<description>clock counter restart</description>
								<bitRange>[7:7]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--usb_ep_busy-->
					<register>
						<name>usb_ep_busy</name>
						<description>* usb_ep_busy *</description>
						<addressOffset>0x24</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>usb_ep_busy</name>
								<description>ep3~1 busy</description>
								<bitRange>[2:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--usb_in_miss-->
					<register>
