				</addressBlock>
				<registers>
					<!--qspi_ctrl-->
					<register>
						<name>qspi_ctrl</name>
						<description>* qspi_ctrl *</description>
						<addressOffset>0x0</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>spi_mode_sel</name>
								<description>0:standard spi, 1:dual s\npi, 2:quad spi</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>intr_en</name>
								<description>qspi interrupt enable</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>half_duplex_mode</name>
								<description>io0 half_duplex_mode</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>enable_cont_read_m_byte</name>
								<description>enable continuous read m\node m byte</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>continuous_read_mode</name>
								<description>continuous read mode</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_clk_reverted</name>
								<description>spi clock is reverted</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dummy_bits_cnt</name>
								<description>dummy bits count</description>
								<bitRange>[11:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>multi_bit_mode</name>
								<description>multi bit mode address b\nytes count</description>
								<bitRange>[15:12]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>qspi_raise_set</name>
								<description>1:qspi sample at posedge\n，0：qspi sample at negedge</description>
								<bitRange>[16:16]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dma_task_status</name>
								<description>1:dma task insert enable\n, 0:dma task wait xip task d\none</description>
								<bitRange>[17:17]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dma_conf_sel</name>
								<description>1:use dma configuration,\n0:configuration select by dm\na and xip</description>
								<bitRange>[18:18]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>sck_gate_en</name>
								<description>1:sck gate enable,0:sck \ngate disable</description>
								<bitRange>[19:19]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>qspi_read_data_delay</name>
								<description>qspi read data delay:\n0: 16 mcu clk cycles\n1: 32 mcu clk cycles\n2: 48 mcu clk cycles\n3: 64 mcu clk cycles</description>
								<bitRange>[21:20]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>async_mode</name>
								<description>asynchronize mode</description>
								<bitRange>[22:22]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>cs_ext_en</name>
								<description>cs ext enable</description>
								<bitRange>[23:23]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>flash_read_cmd_for_xip</name>
								<description>flash read command for x\nip mode</description>
								<bitRange>[31:24]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--qspi_start-->
					<register>
						<name>qspi_start</name>
						<description>* qspi_start *</description>
						<addressOffset>0x4</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>qspi_start</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--qspi_done-->
