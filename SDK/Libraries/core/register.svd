								<description>nan</description>
								<bitRange>[7:7]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--sadc0_int_status-->
					<register>
						<name>sadc0_int_status</name>
						<description>* sadc0_int_status *</description>
						<addressOffset>0x31</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ref sadc0_status</name>
								<description>nan</description>
								<bitRange>[7:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--sadc0_int_en-->
					<register>
						<name>sadc0_int_en</name>
						<description>* sadc0_int_en *</description>
						<addressOffset>0x32</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ref sadc0_status</name>
								<description>nan</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--sadc0_int_clr-->
					<register>
						<name>sadc0_int_clr</name>
						<description>* sadc0_int_clr *</description>
						<addressOffset>0x33</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>eorc</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>eoic</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>wdt</name>
								<description>nan</description>
								<bitRange>[2:2]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>half</name>
								<description>nan</description>
								<bitRange>[3:3]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>ihalf</name>
								<description>nan</description>
								<bitRange>[4:4]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>over</name>
								<description>nan</description>
								<bitRange>[5:5]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>iover</name>
								<description>nan</description>
								<bitRange>[6:6]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>eoc</name>
								<description>nan</description>
								<bitRange>[7:7]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--sadc0_active_list_lo-->
					<register>
						<name>sadc0_active_list_lo</name>
						<description>* sadc0_active_list_lo *</description>
						<addressOffset>0x38</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sadc0_active_list_lo</name>
								<description>bit[i] = 1, channel i in\n low priority active_list </description>
								<bitRange>[15:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--sadc0_active_idx_hi-->
					<register>
						<name>sadc0_active_idx_hi</name>
						<description>* sadc0_active_idx_hi *</description>
						<addressOffset>0x3a</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sadc0_active_idx_hi</name>
								<description>the current active chann\nel for high priority active_\nlist</description>
								<bitRange>[3:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>sadc0_active_idx_lo</name>
								<description>the current active chann\nel for low priority active_l\nist</description>
								<bitRange>[7:4]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>sadc0_active_idx</name>
								<description>the current active chann\nel for all active_list</description>
								<bitRange>[11:8]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--sadc0_rdat-->
					<register>
						<name>sadc0_rdat</name>
						<description>* sadc0_rdat *</description>
						<addressOffset>0x40</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sadc0_rdat</name>
								<description>nan</description>
								<bitRange>[11:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--sadc0_idat-->
					<register>
						<name>sadc0_idat</name>
						<description>* sadc0_idat *</description>
						<addressOffset>0x42</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sadc0_idat</name>
								<description>nan</description>
								<bitRange>[11:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--CAN-->
			<peripheral>
				<name>CAN</name>
				<version>1.0</version>
				<description>CAN</description>
				<groupName>CAN</groupName>
				<baseAddress>0x8c00</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0xb0</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--mode-->
					<register>
						<name>mode</name>
						<description>* mode *</description>
						<addressOffset>0x0</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>reset_mode</name>
								<description>0: normal operation, whe\nn the register changes from \n1 to 0, if the current state\n is not bus_off, wait for 11\n consecutive recessive level\ns before entering idle state\n; if the state is bus_off, w\nait for 128 consecutive 11 r\necessive levels before enter\ning idle state.\n1: can controller immediatel\ny stops the current transmit\nting frame and enters the re\nset state. btl does not work\n. users can configure regist\ners in the reset state.</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>one_shot_mode</name>
								<description>0: automatic resend unti\nl the message is successfull\ny sent.\n1: sends only once. don't re\nsend whether there is an arb\nitration lost or a sending e\nrror.</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reinteg_auto_mode</name>
								<description>0: after entering bus_of\nf state, set reset_mode=1 to\n enter reset_mode and set re\nset_mode=0 to exit reset_mod\ne before exiting bus_off sta\nte and entering integrating \nor reintegrating program.\n1: after entering bus_off st\nate, hardware automatically \nreintegrating program, and a\nutomatically exits bus_off s\ntate and enters idle state a\nfter detecting 128 consecuti\nve 11 recessive levels.</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>acp_filt_mode</name>
								<description>0: acceptance filters ar\ne not used.\n1: use the acceptance filter\n function.</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>wakeup_auto_mode</name>
								<description>0: the software clears s\nleep_mode wake up.\n1: hardware wakes up automat\nically after sof is detected\n.</description>
								<bitRange>[8:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>err_deli_rent</name>
								<description>0: error delimiter occur\n form error，resend error fra\nme.\n1: error delimiter occur for\nm error，don't resend error f\nrame.</description>
								<bitRange>[16:16]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>listen_only_mode</name>
								<description>0: normal mode\n1: listening mode only. can \ncontroller only receives bus\n data, does not send data, a\nnd does not reply ack.the er\nror counter remains the same\n.\nnote: listen_only_mode does \nnot detect ack errors.</description>
								<bitRange>[24:24]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>loopback_mode</name>
								<description>1: in loopback test mode\n, the receiving data line is\n disconnected from the can b\nus and directly connected to\n the sending data line. in l\noopback mode, the data sent \nby itself is received and ac\nk errors are not detected.</description>
								<bitRange>[25:25]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>self_rx_mode</name>
								<description>1: receives data sent by\n itself as well as data on t\nhe bus.</description>
								<bitRange>[26:26]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--command-->
					<register>
						<name>command</name>
						<description>* command *</description>
						<addressOffset>0x4</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>transmit_request</name>
								<description>write '1' to start a sen\nd, cannot write '0' to cance\nl the send.</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>transmit_abort</name>
								<description>write '1' to stop sendin\ng the last frame\nnote:stop sending frames onl\ny during scheduling, arbitra\ntion, or error.\nduring normal sending, the s\nending process cannot be sto\npped, but the reset_mode com\nmand can be used to forcibly\n cancel sending.</description>
								<bitRange>[1:1]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>release_rx_buff</name>
								<description>release receive buffer</description>
								<bitRange>[2:2]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>sleep_mode</name>
								<description>write '0', exit sleep mo\nde\nwrite '1', wait for the curr\nent transmission to complete\n and enter sleep mode.</description>
								<bitRange>[16:16]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--status-->
					<register>
						<name>status</name>
						<description>* status *</description>
						<addressOffset>0x8</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>transmit_busy</name>
								<description>once a frame is transmit\nting, buff busy turns '1', a\nnd user should not change th\ne buff</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>transmit_pend</name>
								<description>1: a frame is transmitti\nng or wait to send.\nafter the command 'tx_abort'\n is executed, you can determ\nine whether the command is e\nxecuted by judging the statu\ns.</description>
								<bitRange>[1:1]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>receive_status</name>
								<description>a frame is ongoing, and \ncan now act as receiver</description>
								<bitRange>[2:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>transmit_status</name>
								<description>a frame is ongoing, and \ncan now act as transmitter</description>
								<bitRange>[3:3]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>can_tx</name>
								<description>the current value of tx \ndata line.</description>
								<bitRange>[4:4]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>can_rx</name>
								<description>the current value of rx \ndata line.</description>
								<bitRange>[5:5]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>sample_bit</name>
								<description>current sample value.</description>
								<bitRange>[6:6]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>idle_status</name>
								<description>the controller is idle.</description>
								<bitRange>[7:7]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>error_passive_status</name>
								<description>the current value of err\nor_passive.</description>
								<bitRange>[8:8]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>bus_off_status</name>
								<description>the current value of bus\n_off.</description>
								<bitRange>[9:9]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>error_frame</name>
								<description>error frames are current\nly being sent.</description>
								<bitRange>[10:10]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>overload_frame</name>
								<description>at89c51c003, p107\noverload frames are currentl\ny being sent.</description>
								<bitRange>[11:11]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--irq-->
					<register>
						<name>irq</name>
						<description>* irq *</description>
						<addressOffset>0xc</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rx_complete_irq</name>
								<description>the reception is complet\ned, but will not necessarily\n pass the acceptance filter \nselection, so will not neces\nsarily be stored in the rx f\nifo.</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_vld_irq</name>
								<description>receive fifo not empty i\nnterrupt.</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_full_irq</name>
								<description>receive fifo full interr\nupt.</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_overrun_irq</name>
								<description>receive fifo overflow in\nterrupt.</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>transmit_irq</name>
								<description>interruption of normal s\nending completion, also set \nif sending fails when comman\nd &quot;transmit_abort&quot;.</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>arbitration_lost_irq</name>
								<description>frame arbitration lost，i\nnterrupt is triggered.</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>bus_error_irq</name>
								<description>this interrupt is trigge\nred when bit error, form err\nor, stuff error, crc error, \nor ack error is detected on \nthe can bus.</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>wakeup_irq</name>
								<description>wakeup signal was detect\ned in sleep mode.</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>error_warning_irq</name>
								<description>the error counter is hig\nher than expected.</description>
								<bitRange>[8:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>enter_passive_irq</name>
								<description>enter passive_err state，\ninterrupt is triggered.</description>
								<bitRange>[9:9]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>exit_passive_irq</name>
								<description>exit passive_err state，i\nnterrupt is triggered.</description>
								<bitRange>[10:10]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>enter_bus_off_irq</name>
								<description>enter bus_off state，inte\nrrupt is triggered.</description>
								<bitRange>[11:11]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>exit_bus_off_irq</name>
								<description>exit bus_off state，inter\nrupt is triggered.</description>
								<bitRange>[12:12]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>time_over_irq</name>
								<description>when time base from 0xff\nff to 0x0000，interrupt is tr\niggered.</description>
								<bitRange>[13:13]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--irq_en-->
					<register>
						<name>irq_en</name>
						<description>* irq_en *</description>
						<addressOffset>0x10</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rx_complete_ie</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_vld_ie</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_full_ie</name>
								<description>nan</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_overrun_ie</name>
								<description>nan</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>transmit_ie</name>
								<description>nan</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>arbitration_lost_ie</name>
								<description>nan</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>bus_error_ie</name>
								<description>nan</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>wakeup_ie</name>
								<description>nan</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>error_warning_ie</name>
								<description>nan</description>
								<bitRange>[8:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>enter_passive_ie</name>
								<description>nan</description>
								<bitRange>[9:9]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>exit_passive_ie</name>
								<description>nan</description>
								<bitRange>[10:10]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>enter_bus_off_ie</name>
								<description>nan</description>
								<bitRange>[11:11]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>exit_bus_off_ie</name>
								<description>nan</description>
								<bitRange>[12:12]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>time_over_ie</name>
								<description>nan</description>
								<bitRange>[13:13]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bus_timing_0-->
					<register>
						<name>bus_timing_0</name>
						<description>* bus_timing_0 *</description>
						<addressOffset>0x20</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>brp</name>
								<description>baud rate prescaler\nthese bits define the length\n of a time quanta.\ntq = (brp[9:0]+2)*tclk_can\nnote:can be configured only \nin reset_mode=1</description>
								<bitRange>[9:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>sjw</name>
								<description>synchronization jump wid\nth \ntsjw = tq*(sjw[1:0]+1)\nnote:can be configured only \nin reset_mode=1</description>
								<bitRange>[17:16]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bus_timing_1-->
					<register>
						<name>bus_timing_1</name>
						<description>* bus_timing_1 *</description>
						<addressOffset>0x24</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tseg1</name>
								<description>time segment 1\nnote:can be configured only \nin reset_mode=1</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tseg2</name>
								<description>time segment 2\nnote:can be configured only \nin reset_mode=1</description>
								<bitRange>[10:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>sam</name>
								<description>sampling mode\n0: sample once\n1: sample three times\nnote:can be configured only \nin reset_mode=1</description>
								<bitRange>[16:16]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--arbi_capture-->
					<register>
						<name>arbi_capture</name>
						<description>* arbi_capture *</description>
						<addressOffset>0x30</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>arb_lost_position</name>
								<description>location of arbitration \nlost.\ntx_request write '1'，automat\nically clear the arb_lost_po\nstion register.</description>
								<bitRange>[4:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--err_capture-->
					<register>
						<name>err_capture</name>
						<description>* err_capture *</description>
						<addressOffset>0x34</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>error_segment</name>
								<description>4: sof\n5: id[28:18]\n6: rtr of stid\n7: ide\n8: fdf of stid\n9: id[17:0] of exid\n10: rtr of exid\n11: fdf of exid\n12: rb0 of exid\n13: dlc\n14: data\n15: crc\n16: crc delimiter\n17: ack\n18: ack delimiter\n19: eof\n22: error flag\n23: error wait\n24: error delimiter\n25: overload flag\n26: overload wait\n27: overload delimiter</description>
								<bitRange>[4:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>error_dir</name>
								<description>direction when error occ\nur\n0: transmitter\n1: receiver</description>
								<bitRange>[5:5]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>form_err</name>
								<description>1: form error detected</description>
								<bitRange>[8:8]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>bit_err</name>
								<description>1: bit error detected</description>
								<bitRange>[9:9]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>stuff_err</name>
								<description>1: stuff error detected</description>
								<bitRange>[10:10]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>ack_err</name>
								<description>1: ack error detected</description>
								<bitRange>[11:11]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>crc_err</name>
								<description>1: crc error detected</description>
								<bitRange>[12:12]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>error_overrun</name>
								<description>error capture overflow f\nlag\n1: another error occurs afte\nr the error is caught</description>
								<bitRange>[16:16]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--warn_limit-->
					<register>
						<name>warn_limit</name>
						<description>* warn_limit *</description>
						<addressOffset>0x38</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>error_warning_limit</name>
								<description>error warning limit\nnote:can be configured only \nin reset_mode=1</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--error_cnt-->
					<register>
						<name>error_cnt</name>
						<description>* error_cnt *</description>
						<addressOffset>0x3c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tx_err_cnt</name>
								<description>tx error counter.\nwhen in reset mode, the soft\nware directly overwrites tx \nerror counter by writing the\nse two bytes.</description>
								<bitRange>[8:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_err_cnt</name>
								<description>rx error counter.\nwhen in reset mode, the soft\nware directly overwrites rx \nerror counter by writing thi\ns bytes.</description>
								<bitRange>[23:16]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--time_base-->
					<register>
						<name>time_base</name>
						<description>* time_base *</description>
						<addressOffset>0x40</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>time_base_en</name>
								<description>0: time_base close.\n1: time_base open.</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>time_base_clr</name>
								<description>time_base clear.</description>
								<bitRange>[1:1]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>time_base</name>
								<description>time base.the clock freq\nuency is fcan/prescaler. the\n current value of time_base \ncan be changed directly.</description>
								<bitRange>[31:16]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--stmp-->
					<register>
						<name>stmp</name>
						<description>* stmp *</description>
						<addressOffset>0x44</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tx_stmp_en</name>
								<description>1:tx frame time stamp en\nable.</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_stmp_rplc</name>
								<description>0: sent frame time stamp\n only captured to bit[31:16]\n, not sent with the frame.\n1: send frame time stamp aut\nomatically replaces the 7th \nand 8th bytes (only works wh\nen tlc is 8).</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_stmp_en</name>
								<description>1:rx frame time stamp en\nable.</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>stmp_sel</name>
								<description>location of time stamp.\n0: sof\n1: eof，when tx_stmp_rplc = 1\n，this bit must be set to 0, \notherwise timestamp is incor\nrectly sent.</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>stmp_dir</name>
								<description>0: transmitter, 1: recei\nver</description>
								<bitRange>[8:8]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>stmp</name>
								<description>time stamp value</description>
								<bitRange>[31:16]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--rx_items-->
					<register>
						<name>rx_items</name>
						<description>* rx_items *</description>
						<addressOffset>0x50</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rx_fifo_items</name>
								<description>rx message counter</description>
								<bitRange>[2:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--tx_info_w0-->
