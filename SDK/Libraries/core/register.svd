			<!--CORE_BTDMA-->
			<peripheral>
				<name>CORE_BTDMA</name>
				<version>1.0</version>
				<description>CORE_BTDMA</description>
				<groupName>CORE_BTDMA</groupName>
				<baseAddress>0x8400</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x40</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--bt_cmd-->
					<register>
						<name>bt_cmd</name>
						<description>* bt_cmd *</description>
						<addressOffset>0x0</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>bt_cmd</name>
								<description>9: next_ch\n8: toggle_sn\n7: toggle_nesn\n6: reset modem\n5: recalc dewhiten coded\n4: clear buffers\n3: continue bt dma\n2: step bt dma\n1: start bt dma</description>
								<bitRange>[3:0]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--bt_ctrl-->
					<register>
						<name>bt_ctrl</name>
						<description>* bt_ctrl *</description>
						<addressOffset>0x1</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>bt_ctrl</name>
								<description>[6]: rxcrc_intr_en\n[5]: no_white\n[4]: force cte\n[3]: intr_en\n[2]: crc 16/24bit mode\n[1]: single step debug mode\n[0]: no data toggle</description>
								<bitRange>[6:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bt_status-->
					<register>
						<name>bt_status</name>
						<description>* bt_status *</description>
						<addressOffset>0x2</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>bt_status</name>
								<description>15-8:bt dma state machin\ne\n        {0:idle ... 6:tx1 7:\ntxcrc 9:rxsync 10:rx1 12:rxc\nrc 13:rxchk}\n4: sneq\n3: rx sync found\n2: crc error\n1: bt dma is done\n0: tx buffer is empty</description>
								<bitRange>[15:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--bt_desc_ptr-->
					<register>
						<name>bt_desc_ptr</name>
						<description>* bt_desc_ptr *</description>
						<addressOffset>0x4</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>bt_desc_ptr</name>
								<description>bt packet descriptor poi\nnter</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bt_pptr-->
					<register>
						<name>bt_pptr</name>
						<description>* bt_pptr *</description>
						<addressOffset>0x8</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>bt_pptr</name>
								<description>data packet pointer or r\n/w/j operation address</description>
								<bitRange>[17:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--bt_stack_base-->
					<register>
						<name>bt_stack_base</name>
						<description>* bt_stack_base *</description>
						<addressOffset>0xc</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>bt_stack_base</name>
								<description>btdma call stack base</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bt_white-->
