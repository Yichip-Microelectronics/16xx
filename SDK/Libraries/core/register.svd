						<name>adcd_wptr</name>
						<description>* adcd_wptr *</description>
						<addressOffset>0xc</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adcd_wptr</name>
								<description>current adc dma write po\ninter</description>
								<bitRange>[22:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--adcd_mic_hpf_alpha-->
					<register>
						<name>adcd_mic_hpf_alpha</name>
						<description>* adcd_mic_hpf_alpha *</description>
						<addressOffset>0x10</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
