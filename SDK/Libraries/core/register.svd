								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bt_bits-->
					<register>
						<name>bt_bits</name>
						<description>* bt_bits *</description>
						<addressOffset>0x1c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>bt_bits</name>
								<description>bits or value for read/w\nrite opration</description>
								<bitRange>[25:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--pkt_len-->
					<register>
						<name>pkt_len</name>
						<description>* pkt_len *</description>
						<addressOffset>0x20</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>pkt_len</name>
								<description>recv pkt len</description>
								<bitRange>[7:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--rand_num-->
					<register>
						<name>rand_num</name>
						<description>* rand_num *</description>
						<addressOffset>0x24</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rand_num</name>
								<description>pseudo-random 16bit valu\ne</description>
								<bitRange>[15:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
