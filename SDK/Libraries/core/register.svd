						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>qspi_txaddr</name>
								<description>qspi dma tx buffer addre\nss</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--qspi_rxlen-->
