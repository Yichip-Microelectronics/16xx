						<addressOffset>0x9</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>iic_delay_high_clk_cnt</name>
								<description>scl high clock count</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--iic_delay_setup_clk_cnt_start-->
					<register>
						<name>iic_delay_setup_clk_cnt_start</name>
						<description>* iic_delay_setup_clk_cnt_start *</description>
						<addressOffset>0xa</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>iic_delay_setup_clk_cnt_start</name>
