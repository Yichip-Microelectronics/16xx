					<!--filter2_mask-->
					<register>
						<name>filter2_mask</name>
						<description>* filter2_mask *</description>
						<addressOffset>0xa4</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filter2_mask</name>
								<description>filter group 2 second id\nentifier.</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
