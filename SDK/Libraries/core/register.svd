					<!--rg_lpm_buck_dt_ctrl-->
					<register>
						<name>rg_lpm_buck_dt_ctrl</name>
						<description>* rg_lpm_buck_dt_ctrl *</description>
						<addressOffset>0x10</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rg_lpm_buck_dt_ctrl</name>
								<description>buck pre-drv deadtime co\nntrol.  '0' short deadtime. \n'1'long deadtime</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_fb_sel</name>
								<description>buck output voltage cont\nrol. 0.9v to 3.15v, 75mv/ste\np from 5'b00000 to 5'b11111</description>
								<bitRange>[5:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_freq_cal</name>
								<description>pwm frequence selection \nfrom 4'b0000 to 4'b1111, fro\nm 1.5m to 6.5m </description>
								<bitRange>[9:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_zcd_en</name>
								<description>inductor zero current de\ntection enable, '1' effectiv\ne</description>
								<bitRange>[10:10]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_sense_en</name>
								<description>current sense block iq c\nut down en</description>
								<bitRange>[11:11]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_icut_comp_en</name>
								<description>comp block iq cut down e\nn</description>
								<bitRange>[12:12]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_byp_en</name>
								<description>buck bypass function ena\nble.'1' effective</description>
								<bitRange>[13:13]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_icut_zcd_en</name>
								<description>zcd block iq cut down en</description>
								<bitRange>[14:14]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_vtst_sel</name>
								<description>buck testmode channel se\nlected</description>
								<bitRange>[17:15]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_oc_disen</name>
								<description>over current protection \ndisable '1' effective</description>
								<bitRange>[18:18]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_freq_sel</name>
								<description>frequency cut off enable\n ,'1' effective</description>
								<bitRange>[19:19]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_pfm_pls_sel</name>
								<description>pfm pulse width control.\n from 3'b000 to 3'b111. pfm/\npwm switch point ramps from \nlow to high</description>
								<bitRange>[22:20]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_pfm_disen</name>
								<description>pfm mode disable, '1' ef\nfective</description>
								<bitRange>[23:23]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_bypass_th_sel</name>
								<description>zcd offset voltage selec\nt, from 4'b0000 to 4'b1111, \nfrom low threshold to high t\nhreshold</description>
								<bitRange>[27:24]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_drv_sel</name>
								<description> buck driver slew rate c\nontrol; 0:slow; 1: fast</description>
								<bitRange>[28:28]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_buck_force_ccm</name>
								<description> buck force ccm enable; \n0:disable; 1:enable</description>
								<bitRange>[29:29]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rg_lpm_chgr_shutdown_sw-->
					<register>
						<name>rg_lpm_chgr_shutdown_sw</name>
						<description>* rg_lpm_chgr_shutdown_sw *</description>
						<addressOffset>0x14</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rg_lpm_chgr_shutdown_sw</name>
								<description>force off charger pass t\nransistor\n0: hvin supplied by vbus; 1:\n hvin supplied by battery</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_ichg_set</name>
								<description>charging current control\n in cc phase\n20ma + chgr_ichgr_set * 10ma</description>
								<bitRange>[4:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_tstsel</name>
								<description>charger test2gpio channe\nl sel:\n0: normal; 1: avdd25; 2:vtc_\nloop; 3:vcv_loop; 4:vref_ter\nm; 5:vref_cc; 6:vref_rch; 7:\nvref_cv</description>
								<bitRange>[7:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_pulldown</name>
								<description>charger input sink curre\nnt enable. used to wake up c\nharger case and to be turned\n off upon the end of chargin\ng process.\n0: 29ua; 1:58ua；2:84ua; 3:11\n2ua; 4:307ua; 5:330ua; 6:351\nua; 7:disable</description>
								<bitRange>[10:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_indcmp_en</name>
								<description>charger status indicator\n enable\n1: dppm/cc/cv statuse indica\ntor enable; 0: disable</description>
								<bitRange>[11:11]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[13:12]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_rchc</name>
								<description>battery voltage threshol\nd adjustments for re-chargin\ng in 53mv/steps\nnominal value: 4.1v</description>
								<bitRange>[17:14]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_force_cv</name>
								<description>charger cv mode force en\nable. only valid when chgr_f\norce_core_on = 1 or charging\n is on-going\n0: normal operation; 1: forc\ne on</description>
								<bitRange>[18:18]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_shutdown_core</name>
								<description>force off charger cc &amp; c\nv loop\n0: on; 1: off</description>
								<bitRange>[19:19]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_termc</name>
								<description>charging termination cur\nrent control \n0: 10% cc current\n1: 20% cc current\n2: 30% cc current\n3: 40% cc current</description>
								<bitRange>[21:20]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_tcc</name>
								<description>charger trickle current \ncontrol when vbat &lt; 3.0v\n0: 10% cc current\n1: 20% cc current\n2: 30% cc current\n3: 40% cc current</description>
								<bitRange>[23:22]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_cvc</name>
								<description>charger target battery v\noltage adjustments for cv ph\nase in 53mv/steps\nnominal value: 4.2v </description>
								<bitRange>[27:24]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_uart_en</name>
								<description>charger uart enable\n0: enable; 1: disable</description>
								<bitRange>[28:28]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_force_cc</name>
								<description>charger cc mode force en\nable. only valid when chgr_f\norce_core_on = 1 or charging\n is on-going\n0: normal operation; 1: forc\ne on</description>
								<bitRange>[29:29]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_shutdown_bias</name>
								<description>force off charger bias\n0: on; 1: off</description>
								<bitRange>[30:30]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_lpm_chgr_force_core_on</name>
								<description>force on charger cc &amp; cv\n loop when charger is in sta\nndby mode. only valid when c\nhgr_shutdown_core = 0</description>
								<bitRange>[31:31]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
