				<groupName>CORE_QSPI1</groupName>
				<baseAddress>0x8380</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x1c</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--qspi1_ctrl-->
					<register>
						<name>qspi1_ctrl</name>
						<description>* qspi1_ctrl *</description>
						<addressOffset>0x0</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>mode_cmd</name>
								<description>command field mode,\n0:standard spi, 1:dual spi, \n2:quad spi</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>intr_clr</name>
								<description>intr_clr:</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dc_mode</name>
								<description>9bit mode select</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
