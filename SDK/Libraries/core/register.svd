						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>nec_mode</name>
								<description>0:tx 不发载波\n1:level=1 发送载波\n2:level=0 发送载波\n3:rx模式</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--nec_intr_en-->
					<register>
						<name>nec_intr_en</name>
