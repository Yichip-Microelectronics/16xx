						<name>filter0_mask</name>
						<description>* filter0_mask *</description>
						<addressOffset>0x94</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filter0_mask</name>
								<description>filter group 0 second id\nentifier.</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
