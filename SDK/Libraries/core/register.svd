								<bitRange>[5:5]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>ep3_out_stall</name>
								<description>endpoint 3 out is stall</description>
								<bitRange>[6:6]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rxbuf_empty</name>
