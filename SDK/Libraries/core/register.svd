						<addressOffset>0x3</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rg_gpadc_sar_vcm_isel</name>
								<description>commom voltage buffer bi\nas current selected</description>
