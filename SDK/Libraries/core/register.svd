							<field>
								<name>tx_byte4</name>
								<description>tx data byte 7</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_byte5</name>
								<description>tx data byte 6</description>
								<bitRange>[15:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_byte6</name>
								<description>tx data byte 5</description>
								<bitRange>[23:16]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_byte7</name>
								<description>tx data byte 4</description>
								<bitRange>[31:24]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rx_info_w0-->
					<register>
						<name>rx_info_w0</name>
						<description>* rx_info_w0 *</description>
						<addressOffset>0x70</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rx_rtr</name>
								<description>remote transmission requ\nest</description>
								<bitRange>[1:1]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_ide</name>
								<description>identifier extension</description>
								<bitRange>[2:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_id_17_0</name>
