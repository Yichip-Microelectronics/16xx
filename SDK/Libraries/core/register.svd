								<bitRange>[5:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_gpadc_pga0_en</name>
								<description>saradc input buffer enab\nle</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
