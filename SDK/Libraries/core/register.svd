<?xml version="1.0" encoding="utf-8"?>
	<device schemaVersion="1.0" xmlns:xs="http://www.yichip.com/" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_0.xsd">
		<name>yc1161</name>
		<version>1.0</version>
		<series>RISC-V</series>
		<description>32-bit RV Microcontroller based device, CPU clock up to 96MHz, etc.</description>
		<licenseText>YC is supplying the software is provided for yc1161 microprocessor.</licenseText>
		<cpu>
			<name>RISC-V</name>
			<revision>1.0</revision>
			<endian>little</endian>
			<mpuPresent>false</mpuPresent>
			<fpuPresent>false</fpuPresent>
			<nvicPrioBits>8</nvicPrioBits>
			<vendorSystickConfig>false</vendorSystickConfig>
		</cpu>
		<addressUnitBits>8</addressUnitBits>
		<width>32</width>
		<size>32</size>
		<access>read-write</access>
		<resetValue>0x00000000</resetValue>
		<resetMask>0xFFFFFFFF</resetMask>
		<peripherals>
			<!--CORE_CHIP_SYS-->
			<peripheral>
				<name>CORE_CHIP_SYS</name>
				<version>1.0</version>
				<description>CORE_CHIP_SYS</description>
				<groupName>CORE_CHIP_SYS</groupName>
				<baseAddress>0x8000</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x90</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--revision-->
					<register>
						<name>revision</name>
						<description>* revision *</description>
						<addressOffset>0x0</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>revision</name>
								<description>design version</description>
								<bitRange>[15:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--mfv_d-->
					<register>
						<name>mfv_d</name>
						<description>* mfv_d *</description>
						<addressOffset>0x2</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>mfv_d</name>
								<description>metal fix version for re\nad</description>
								<bitRange>[5:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--cache_init-->
					<register>
						<name>cache_init</name>
						<description>* cache_init *</description>
						<addressOffset>0x6</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>cache_init</name>
								<description>write key byte (8bits) t\no init icache\nkey byte: 0x9b</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--cache_ctrl-->
					<register>
						<name>cache_ctrl</name>
						<description>* cache_ctrl *</description>
						<addressOffset>0x7</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>cache_ctrl</name>
								<description>cache_ctrl[1:0] :  {mem_\nmode, bus_mode}</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--dpll48_div-->
					<register>
						<name>dpll48_div</name>
						<description>* dpll48_div *</description>
						<addressOffset>0x8</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>dpll48_div</name>
								<description>dpll48m clock division. \n384/(5+div)</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--qspi_clk_sel-->
					<register>
						<name>qspi_clk_sel</name>
						<description>* qspi_clk_sel *</description>
						<addressOffset>0x9</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>qspi_clk_sel</name>
								<description>qspi dpll clock source: \n0: 24mhz, 1: 48mhz, 2: 64mhz\n, 3: 96mhz</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>qspi1_clk_sel</name>
								<description>qspi1 dpll clock source:\n 0: 24mhz, 1: 48mhz, 2: 64mh\nz, 3: 96mhz</description>
								<bitRange>[3:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>qspi2_clk_sel</name>
								<description>qspi2 dpll clock source:\n 0: 24mhz, 1: 48mhz, 2: 64mh\nz, 3: 96mhz</description>
								<bitRange>[5:4]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--sys_clksel-->
					<register>
						<name>sys_clksel</name>
						<description>* sys_clksel *</description>
						<addressOffset>0xa</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sys_clksel</name>
								<description>system clock source. 0:r\nc, 1: dpll, 2:crystal, 3:lpo\nclk</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>uart_clksel</name>
								<description>when system clock select\n rc, uart clock use rc clock\n, else\nuart clock select. 0: crysta\nl 1: dpll 48mhz</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>sys_clkdiv</name>
								<description>system clock division. 0\n-15, 1 to 16</description>
								<bitRange>[6:3]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--mcu_clk_sel-->
					<register>
						<name>mcu_clk_sel</name>
						<description>* mcu_clk_sel *</description>
						<addressOffset>0xb</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>mcu_clk_sel</name>
								<description>mcu dpll clock source: 0\n: 24mhz, 1: 48mhz, 2: 64mhz,\n 3: 96mhz,\n4:128mhz,  5:192mhz, 6:256mhz</description>
								<bitRange>[2:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--sys_reset-->
					<register>
						<name>sys_reset</name>
						<description>* sys_reset *</description>
						<addressOffset>0x10</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>reserved0</name>
								<description>reserved</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>sys_reset</name>
								<description>[1]: write 1 to reset sy\nstem</description>
								<bitRange>[1:1]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--sys_event_lock-->
					<register>
						<name>sys_event_lock</name>
						<description>* sys_event_lock *</description>
						<addressOffset>0x11</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sys_reset_lock</name>
								<description>sys_reset event lock for\n debug</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>io_rst_req_lock</name>
								<description>io reset event lock for \ndebug</description>
								<bitRange>[1:1]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>wdt_rst_req_lock</name>
								<description>watch dog reset event lo\nck for debug</description>
								<bitRange>[2:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>chgr_rst_req_lock</name>
								<description>charge reset event lock \nfor debug</description>
								<bitRange>[3:3]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>code_crc_fail_lock</name>
								<description>flash_crc error lock for\n debug</description>
								<bitRange>[4:4]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>cpu_i_access_err_lock</name>
								<description>cpu_i_access_err error l\nock for debug</description>
								<bitRange>[5:5]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>cpu_d_access_err_lock</name>
								<description>cpu_d_access_err error l\nock for debug</description>
								<bitRange>[6:6]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>vio33_err_lock</name>
								<description>vio33_pgood error lock f\nor debug</description>
								<bitRange>[7:7]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--sys_event_clr-->
					<register>
						<name>sys_event_clr</name>
						<description>* sys_event_clr *</description>
						<addressOffset>0x12</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sys_reset_lock_clr</name>
								<description>clear the sys_reset_lock\n flag</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>io_rst_req_lock_clr</name>
								<description>clear the io_rst_req_loc\nk flag</description>
								<bitRange>[1:1]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>wdt_rst_req_lock_clr</name>
								<description>clear the wdt_rst_req_lo\nck flag</description>
								<bitRange>[2:2]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>chgr_rst_req_lock_clr</name>
								<description>clear the charge reset r\neq lock flag</description>
								<bitRange>[3:3]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>code_crc_fail_lock_clr</name>
								<description>clear the flash_crc_err_\nlock flag</description>
								<bitRange>[4:4]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>cpu_i_access_err_lock_clr</name>
								<description>clear cpu_i_access_err_l\nock flag</description>
								<bitRange>[5:5]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>cpu_d_access_err_lock_clr</name>
								<description>clear cpu_d_access_err_l\nock flag</description>
								<bitRange>[6:6]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>vio33_err_lock_clr</name>
								<description>clear the vio33_pgood er\nror lock flag</description>
								<bitRange>[7:7]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--sys_status-->
					<register>
						<name>sys_status</name>
						<description>* sys_status *</description>
						<addressOffset>0x14</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>crystal_stable</name>
								<description>crystal is stable</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>lpo_clock</name>
								<description>synchronized lpo clock</description>
								<bitRange>[1:1]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>code_crc_fail</name>
								<description>code crc check fail</description>
								<bitRange>[2:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>vio33_pgood</name>
								<description>vdd io 3.3v power good</description>
								<bitRange>[3:3]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>vo25_efuse_pgood</name>
								<description>efuse power good</description>
								<bitRange>[4:4]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rv_wfi</name>
								<description>rv enter wfi</description>
								<bitRange>[5:5]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--anaclk_en-->
					<register>
						<name>anaclk_en</name>
						<description>* anaclk_en *</description>
						<addressOffset>0x17</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rf_lpoclk_en</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>clk_rc_en</name>
								<description>analog output clock sync\n clock gate enable</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>xtalclk_en</name>
								<description>analog output clock sync\n clock gate enable</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ck2bbpll_rco</name>
								<description>rc32m connect to bbpll</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[5:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>clk_dpll_384_en</name>
								<description>analog output clock sync\n clock gate enable</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>clk_dpll_256_en</name>
								<description>analog output clock sync\n clock gate enable</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--clken-->
					<register>
						<name>clken</name>
						<description>* clken *</description>
						<addressOffset>0x18</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>mcu_inter_clk_en</name>
								<description>mcu internal clock enabl\ne</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>cpu</name>
								<description>0</description>
								<bitRange>[8:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>mram</name>
								<description>1</description>
								<bitRange>[9:9]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>usb</name>
								<description>2</description>
								<bitRange>[10:10]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>uart</name>
								<description>3</description>
								<bitRange>[11:11]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>uartb</name>
								<description>4</description>
								<bitRange>[12:12]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>aes</name>
								<description>5</description>
								<bitRange>[13:13]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>gdac</name>
								<description>6</description>
								<bitRange>[14:14]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>bt_dma</name>
								<description>7</description>
								<bitRange>[15:15]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi</name>
								<description>8</description>
								<bitRange>[16:16]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>iic</name>
								<description>9</description>
								<bitRange>[17:17]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>iic1</name>
								<description>10</description>
								<bitRange>[18:18]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>mic_dsm</name>
								<description>11</description>
								<bitRange>[19:19]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>mic</name>
								<description>12</description>
								<bitRange>[20:20]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ice</name>
								<description>13</description>
								<bitRange>[21:21]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>nec</name>
								<description>14</description>
								<bitRange>[22:22]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>uartc</name>
								<description>15</description>
								<bitRange>[23:23]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>uartd</name>
								<description>16</description>
								<bitRange>[24:24]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>lpm</name>
								<description>17</description>
								<bitRange>[25:25]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>qspi</name>
								<description>18</description>
								<bitRange>[26:26]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>can</name>
								<description>19</description>
								<bitRange>[27:27]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--audio_clkctrl-->
					<register>
						<name>audio_clkctrl</name>
						<description>* audio_clkctrl *</description>
						<addressOffset>0x1c</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>mic_clk_sel</name>
								<description>0: from gpio\n1: dsmdiv_clk</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[2:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>vof_sel</name>
								<description>0:48m  1:64m</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>mic_clk_div</name>
								<description>0:div1, 1: div2,  2: div\n3;  3: rvd</description>
								<bitRange>[5:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>gdac_clk_sel</name>
								<description>0:12m  1:24m  2: 48m</description>
								<bitRange>[7:6]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--systick_ovwr_dat-->
					<register>
						<name>systick_ovwr_dat</name>
						<description>* systick_ovwr_dat *</description>
						<addressOffset>0x30</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>systick_ovwr_dat</name>
								<description>systick over write data</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--systick_ovwr_rtc_val-->
					<register>
						<name>systick_ovwr_rtc_val</name>
						<description>* systick_ovwr_rtc_val *</description>
						<addressOffset>0x34</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>systick_ovwr_rtc_val</name>
								<description>systick over write time\nwhen systick_ovwr_cmt = 1, o\nver write systick with systi\nck_ovwr_dat at the rising ed\nge of lpo_clk when rtc_cnt =\n rtc_val</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--systick_div1m-->
					<register>
						<name>systick_div1m</name>
						<description>* systick_div1m *</description>
						<addressOffset>0x38</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>systick_div1m</name>
								<description>system tick increase clo\nck equal to sysclk/(systick_\ndiv1m +1)</description>
								<bitRange>[8:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--timer-->
					<register>
						<name>timer</name>
						<description>* timer *</description>
						<addressOffset>0x3c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>timer</name>
								<description>generate interrupt when \nequal to systick</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--systick-->
					<register>
						<name>systick</name>
						<description>* systick *</description>
						<addressOffset>0x40</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>systick</name>
								<description>systick counter current \nvalue\nincrease every (systick_div1\nm+1) system clock</description>
								<bitRange>[31:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--rtc_systick_sync_cmd-->
					<register>
						<name>rtc_systick_sync_cmd</name>
						<description>* rtc_systick_sync_cmd *</description>
						<addressOffset>0x44</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rtc_systick_sync_cmd</name>
								<description>write 1 to sync the rtc_\ncnt and systick at lpo_clk r\nising edge</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>systick_ovwr_cmd</name>
								<description>write 1 to overwrite the\n systick at lpo_clk rising e\ndge when </description>
								<bitRange>[1:1]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[3:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rtc_systick_sync_done</name>
								<description>rtc_cnt and systick sync\n done flag, clear when rtc_s\nystick_sync_cmd = 1</description>
								<bitRange>[4:4]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>systick_ovwr_done</name>
								<description>systick overwrite done f\nlag, clear when systick_ovwr\n_cmd = 1</description>
								<bitRange>[5:5]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>reserved2</name>
								<description>reserved</description>
								<bitRange>[7:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>software_irq</name>
								<description>software irq</description>
								<bitRange>[8:8]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rtc_cnt_sync-->
					<register>
						<name>rtc_cnt_sync</name>
						<description>* rtc_cnt_sync *</description>
						<addressOffset>0x48</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rtc_cnt_sync</name>
								<description>rtc_cnt value when rtc_c\nnt and systick sync done</description>
								<bitRange>[31:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--systick_sync-->
					<register>
						<name>systick_sync</name>
						<description>* systick_sync *</description>
						<addressOffset>0x4c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>systick_sync</name>
								<description>systick value when rtc_c\nnt and systick sync done</description>
								<bitRange>[31:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--debug_baud-->
					<register>
						<name>debug_baud</name>
						<description>* debug_baud *</description>
						<addressOffset>0x74</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>debug_baud</name>
								<description>debug uart baud rate det\nected</description>
								<bitRange>[7:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--wdt_counter-->
					<register>
						<name>wdt_counter</name>
						<description>* wdt_counter *</description>
						<addressOffset>0x78</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>wdt_counter</name>
								<description>set cpu watch dog counte\nr[19:12]\nwdt timer = 16 - val/8 (s)</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>wdt_int_en</name>
								<description>watch dog interrupt mode\n enable\n0: watch dog timeout request\n soft_reset\n1: watch dog timeout request\n interrupt</description>
								<bitRange>[8:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[11:9]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>wdt_hold_en</name>
								<description>1:hold wdt when wfi</description>
								<bitRange>[12:12]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--io_rst_wdat-->
					<register>
						<name>io_rst_wdat</name>
						<description>* io_rst_wdat *</description>
						<addressOffset>0x7a</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>io_rst_wdat</name>
								<description>io reset timer set:\nreset time = 64 - 8 * val(s)</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--io_rst_src_en-->
					<register>
						<name>io_rst_src_en</name>
						<description>* io_rst_src_en *</description>
						<addressOffset>0x7b</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>code_crc_fail_rst_en</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>cpu_access_err_fail_rst_en</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>gpio20_long_rst_en</name>
								<description>gpio20 long press reset \nenable</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>gpio26_long_rst_en</name>
								<description>gpio26 long press reset \nenable</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>gpio31_long_rst_en</name>
								<description>gpio31 long press reset \nenable</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--sys_timer-->
					<register>
						<name>sys_timer</name>
						<description>* sys_timer *</description>
						<addressOffset>0x80</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sys_timer</name>
								<description>generate system timer in\nterrupt when equal to systic\nk</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--sys_timer_en-->
					<register>
						<name>sys_timer_en</name>
						<description>* sys_timer_en *</description>
						<addressOffset>0x84</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sys_timer_en</name>
								<description>enable system timer inte\nrrupt</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>timer_enable</name>
								<description>enable bt_timer interrup\nt</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>sys_timer_autoadd</name>
								<description>auto add sys_timer_perio\nd into sys_timer when sys_ti\nmer timeout or at the rising\n edge of sys_timer_autoadd t\no generate periodic interrup\nt\nnew sys_timer = systick + sy\ns_timer_period</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[3:3]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>intr_sys_tmr</name>
								<description>system timer interrupt s\ntatus</description>
								<bitRange>[4:4]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>intr_tmr</name>
								<description>bt_timer interrupt statu\ns</description>
								<bitRange>[5:5]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--sys_timer_period-->
					<register>
						<name>sys_timer_period</name>
						<description>* sys_timer_period *</description>
						<addressOffset>0x88</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sys_timer_period</name>
								<description>system timer interrupt p\neriod when enable sys_timer_\nautoadd</description>
								<bitRange>[23:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--sysclk_reg-->
					<register>
						<name>sysclk_reg</name>
						<description>* sysclk_reg *</description>
						<addressOffset>0x8c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sysclk_reg</name>
								<description>nan</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
