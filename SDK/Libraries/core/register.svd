							<field>
								<name>nec_rptr</name>
								<description>rx: nec read pointer\ntx: nec write pointer</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--nec_ctrl-->
					<register>
						<name>nec_ctrl</name>
						<description>* nec_ctrl *</description>
						<addressOffset>0xc</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>enable</name>
								<description>nec detect enable</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>clk_div</name>
