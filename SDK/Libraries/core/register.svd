								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_gpadc_sar_dat_sel</name>
								<description>mismatch coefficients da\nta read/write for c0~c6 sele\ncted</description>
								<bitRange>[7:5]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--gpadc_cfg3-->
					<register>
						<name>gpadc_cfg3</name>
						<description>* gpadc_cfg3 *</description>
						<addressOffset>0x4</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rg_gpadc_sar_vref_sel</name>
								<description>reference voltage select\ned:\n0: from internal voltage buf\nfer; 1: from avdd33_io; 2:fr\nom pad</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_gpadc_sar_vref_isel</name>
