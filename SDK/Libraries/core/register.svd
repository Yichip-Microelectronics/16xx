							</field>
							<field>
								<name>suspend</name>
								<description>suspend state</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>nak</name>
								<description>nak state</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rst</name>
								<description>reset state</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ack</name>
								<description>ack state</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_ready</name>
								<description>rx ready state</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>buf_full</name>
								<description>rx buffer full</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>sof_cali_done</name>
								<description>sof clock calibration do\nne</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ep0_txdoen</name>
								<description>endpoint 0 tx done</description>
								<bitRange>[8:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ep1_txdoen</name>
								<description>endpoint 1 tx done</description>
								<bitRange>[9:9]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ep2_txdoen</name>
								<description>endpoint 2 tx done</description>
								<bitRange>[10:10]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ep3_txdoen</name>
								<description>endpoint 3 tx done</description>
								<bitRange>[11:11]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_done</name>
								<description>nan</description>
								<bitRange>[12:12]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--usb_status-->
					<register>
						<name>usb_status</name>
						<description>* usb_status *</description>
						<addressOffset>0x30</addressOffset>
						<size>8</size>
