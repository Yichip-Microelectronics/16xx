					<register>
						<name>rfpll_cal_ctrl10</name>
						<description>* rfpll_cal_ctrl10 *</description>
						<addressOffset>0xc</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rg_rfpll_dac_code_force_val</name>
								<description>nan</description>
								<bitRange>[9:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rfpll_cal_ctrl11-->
					<register>
						<name>rfpll_cal_ctrl11</name>
						<description>* rfpll_cal_ctrl11 *</description>
						<addressOffset>0xe</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rg_rfpll_afc_data_sync_force_val</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_rfpll_afc_count_rstn_force_val</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_rfpll_afc_count_en_force_val</name>
								<description>nan</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_rfpll_afc_count_force_en</name>
								<description>nan</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_rfpll_cal_result_sel</name>
								<description>rfpll calibration output\n data write to reg, differen\nt results depend on rg_rfpll\n_cal_result_sel value: \n3'b000: afc results: &lt;6:0&gt; f\ninal vco cap band, &lt;13:7&gt; af\nc each bit cap move directio\nn, 1 for up, 0 for dn, &lt;19&gt; \nghpc_finish, &lt;18&gt; aac_finish\n, &lt;17&gt; afc_finish \n3'b001: afc min_err results\n3'b010: aac results: &lt;3:0&gt; a\nac final vco res sel,\n3'b011: ghpc fisrt count res\nults\n3'b100: ghpc second count re\nsults</description>
								<bitRange>[6:4]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rfpll_cal_result-->
