			<!--CORE_AUDIO_ADC0-->
			<peripheral>
				<name>CORE_AUDIO_ADC0</name>
				<version>1.0</version>
				<description>CORE_AUDIO_ADC0</description>
				<groupName>CORE_AUDIO_ADC0</groupName>
				<baseAddress>0x8700</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x38</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--adcd_dcoff-->
					<register>
						<name>adcd_dcoff</name>
						<description>* adcd_dcoff *</description>
						<addressOffset>0x0</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>dc_offset</name>
								<description>dc offset</description>
								<bitRange>[15:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_delay-->
					<register>
						<name>adcd_delay</name>
						<description>* adcd_delay *</description>
						<addressOffset>0x2</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adc_channel_switch_delay</name>
								<description>adc channel switch delay\n counter, based on 3m</description>
								<bitRange>[6:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>voice_filter_block_en</name>
								<description>voice filter block enabl\ne</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_ctrl-->
					<register>
						<name>adcd_ctrl</name>
						<description>* adcd_ctrl *</description>
						<addressOffset>0x3</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ave_time_rssi</name>
								<description>average time for rssi</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>clr_rssi</name>
								<description>clear rssi </description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rssi_en</name>
								<description>rssi enable</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>cic_ds_sel</name>
								<description>cic_ds_sel: 0: down samp\nle 32; 1: down sample 16</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>data_type</name>
								<description>1:raw adc data, 0:voice \ndata</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>vof_wr_en</name>
								<description>adc vof write enable</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dma_en</name>
								<description>adc dma enable </description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_saddr-->
					<register>
						<name>adcd_saddr</name>
						<description>* adcd_saddr *</description>
						<addressOffset>0x4</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adcd_saddr</name>
								<description>adc dma start address</description>
								<bitRange>[22:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_buflen-->
					<register>
						<name>adcd_buflen</name>
						<description>* adcd_buflen *</description>
						<addressOffset>0x8</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
