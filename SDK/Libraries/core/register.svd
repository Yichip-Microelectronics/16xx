						<name>filter0_code</name>
						<description>* filter0_code *</description>
						<addressOffset>0x90</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filter0_code</name>
								<description>filter group 0 first ide\nntifier.</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--filter0_mask-->
