					<!--filter_init-->
					<register>
						<name>filter_init</name>
						<description>* filter_init *</description>
						<addressOffset>0x80</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filt_init</name>
								<description>acceptance filter initia\nlization control\n0: the filter group is worki\nng in normal mode.\n1: the filter group works in\n initialization mode, in whi\nch the software can modify t\nhe register configuration of\n the acceptance filter.\nnote:can be configured only \nin reset_mode=1</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[5:1]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--filter_mode-->
					<register>
						<name>filter_mode</name>
						<description>* filter_mode *</description>
						<addressOffset>0x84</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filt_mode</name>
								<description>0: filter group x's two \n32-bit registers work in ide\nntifier masked bit mode;\n1: filter group x's two 32-b\nit registers work in identif\nier list mode.</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--filter_scale-->
					<register>
						<name>filter_scale</name>
						<description>* filter_scale *</description>
						<addressOffset>0x88</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filt_scale</name>
								<description>0: the filter bit width \nis two 16-bit.\n1: the filter bit width is o\nne 32-bit.</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--filter_active-->
					<register>
						<name>filter_active</name>
						<description>* filter_active *</description>
						<addressOffset>0x8c</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filt_active</name>
								<description>0: filter is disabled;\n1: filter is activated.</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--filter0_code-->
