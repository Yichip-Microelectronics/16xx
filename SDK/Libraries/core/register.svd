							<field>
								<name>rg_gpadc_sar_datin</name>
								<description>data write to cap mismat\nch coefficients</description>
								<bitRange>[6:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_gpadc_sar_conv_mode</name>
