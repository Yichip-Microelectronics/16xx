								<bitRange>[31:21]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--rx_info_w1-->
					<register>
						<name>rx_info_w1</name>
						<description>* rx_info_w1 *</description>
						<addressOffset>0x74</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
