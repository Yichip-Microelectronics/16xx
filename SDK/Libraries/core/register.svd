						<fields>
							<field>
								<name>gpi_counter_cali</name>
								<description>gpi clock count for cali\nbration 0-15 for 1-32768 </description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>gpi_cali_start</name>
								<description>write 1 to start gpi cal\nibration counter</description>
								<bitRange>[4:4]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--gpi_cali_done-->
					<register>
						<name>gpi_cali_done</name>
						<description>* gpi_cali_done *</description>
						<addressOffset>0x4</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>gpi_cali_cnt</name>
								<description>clock calibration result</description>
								<bitRange>[30:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>gpi_cali_done</name>
								<description>clock calibration done</description>
								<bitRange>[31:31]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--gpi_cali_sel-->
					<register>
						<name>gpi_cali_sel</name>
						<description>* gpi_cali_sel *</description>
						<addressOffset>0x8</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>gpi_cali_sel</name>
								<description>gpio sellect to gpi_cali</description>
								<bitRange>[5:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--CORE_CHGR-->
			<peripheral>
				<name>CORE_CHGR</name>
				<version>1.0</version>
				<description>CORE_CHGR</description>
				<groupName>CORE_CHGR</groupName>
				<baseAddress>0x80e0</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x5</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--chgr_intr_en-->
					<register>
						<name>chgr_intr_en</name>
						<description>* chgr_intr_en *</description>
						<addressOffset>0x0</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ad_lpm_chgr_in_det_aon</name>
								<description>0:vchargin&lt;1.2\n1:vchargin&gt;1.2</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ad_lpm_chgr_state_ind</name>
								<description>1:vbat&lt;(3v || 复充电压) || 充\n电电流&gt;termianal电流</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ad_lpm_chgr_uvlo_ok_aon</name>
								<description>0:vchargin&lt;4.35\n1:vchargin&gt;4.35</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ad_lpm_chgr_pgood</name>
								<description>1: vchargin&gt;4.35 || vcha\nrgin&gt;锂电池+0.35</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--chgr_intr_mod-->
					<register>
						<name>chgr_intr_mod</name>
						<description>* chgr_intr_mod *</description>
						<addressOffset>0x4</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ad_lpm_chgr_in_det_aon</name>
								<description>1: status eq 0 generate \nirq \n0: status eq 1 generate irq </description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ad_lpm_chgr_state_ind</name>
								<description>same as bit 0</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ad_lpm_chgr_uvlo_ok_aon</name>
								<description>same as bit 0</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ad_lpm_chgr_pgood</name>
								<description>same as bit 0</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--CORE_SOFT_DMA-->
