								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_gpadc_sar_en</name>
								<description>saradc enable</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_gpadc_sar_ldo_en</name>
								<description>ldo for saradc enable</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--gpadc_cfg0-->
