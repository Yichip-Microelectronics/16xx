								<bitRange>[13:13]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_fir_ctrl-->
					<register>
						<name>adcd_fir_ctrl</name>
						<description>* adcd_fir_ctrl *</description>
						<addressOffset>0x12</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adc_comp_scale</name>
								<description>adc_comp_scale: 0~7:  4~\n -3</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>adc_hbf_scale</name>
								<description>adc_hbf_scale: 0~7: 4~ -\n3</description>
								<bitRange>[7:4]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_mic_ctrl-->
					<register>
						<name>adcd_mic_ctrl</name>
						<description>* adcd_mic_ctrl *</description>
						<addressOffset>0x13</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>micclk_sel</name>
								<description>micclk_sel: \n       0：from pll; 1: pll di\nv2;   2: pll div4; </description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>micclk_inv</name>
								<description>micclk_inv: inverse the \nmicclk to analog/pdm</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>anaclk_en</name>
								<description>anaclk_en: enable the mi\ncclk to analog</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>micdat_mode</name>
								<description>micdat_mode: 0: signed m\node; 1: unsigned mode</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>pdmclk_en</name>
								<description>pdmclk_en: enable the mi\ncclk to pdm</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>pdmdat_sel</name>
								<description>pdmdat_sel:\n     0: latch data on the ri\nsing clock edge;  \n     1: latch data on the fa\nlling clock edge</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>mic_src</name>
								<description>mic_src: 0: micdata from\n ana mic, 1 micdata from pdm</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_dc_ctrl-->
					<register>
						<name>adcd_dc_ctrl</name>
						<description>* adcd_dc_ctrl *</description>
						<addressOffset>0x14</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adc_dc_dly_time</name>
								<description>adc_dc_dly_time: 0~3: 32\n/64/128/256 smps;</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>adc_dc_avg_time</name>
								<description>adc_dc_avg_time: 0~3: 12\n8/256/512/1024 smps</description>
								<bitRange>[3:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>adc_bit24_en</name>
								<description>enable adc 24 bit mode</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>adc_dc_en</name>
								<description>adc_dc_en : enable the d\nc calc </description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_vol_ctrl-->
					<register>
						<name>adcd_vol_ctrl</name>
						<description>* adcd_vol_ctrl *</description>
						<addressOffset>0x18</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adc_vol_step</name>
								<description>adc_vol_step : adc vol s\ntep of channel prompt</description>
								<bitRange>[7:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>adc_vol_target_val </name>
								<description>adc_vol_target_val \n      adc vol target value o\nf channel prompt, \n      scale in u(14,12)</description>
								<bitRange>[21:8]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>adc_mute_en</name>
								<description>adc_mute_en: mute adc ch\nannel</description>
								<bitRange>[22:22]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>adc_vol_fade_dis</name>
								<description>adc_vol_fade_dis\n0: enable volume fadein/fade\nout functionn when change th\ne volume value. the volume w\nill change gradully to the v\nol or 0 with the step of vol\n_step\n1: disable volume fadein/fad\neout. the volume will change\n immediately to the vol or 0\n.</description>
								<bitRange>[23:23]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[30:24]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>adcd_vol_ctrl_wr</name>
								<description>write 1 to sync the adc_\nvol regs into mic clock doma\nin</description>
								<bitRange>[31:31]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--adcd_avg_power-->
					<register>
						<name>adcd_avg_power</name>
						<description>* adcd_avg_power *</description>
						<addressOffset>0x1c</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adcd_avg_power</name>
								<description>rssi_average_power</description>
								<bitRange>[13:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--adcd_avg_dc-->
					<register>
						<name>adcd_avg_dc</name>
						<description>* adcd_avg_dc *</description>
						<addressOffset>0x1e</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adcd_avg_dc</name>
								<description>average dc</description>
								<bitRange>[15:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--adcd_vof_wr_strobe-->
					<register>
						<name>adcd_vof_wr_strobe</name>
						<description>* adcd_vof_wr_strobe *</description>
						<addressOffset>0x22</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adcd_vof_wr_strobe</name>
								<description>adc coef write strobe</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--adcd_vof_coef_wdata-->
					<register>
						<name>adcd_vof_coef_wdata</name>
						<description>* adcd_vof_coef_wdata *</description>
						<addressOffset>0x24</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adcd_vof_coef_wdata</name>
								<description>adc coef wdata</description>
								<bitRange>[23:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_dsmdiv_ctrl-->
					<register>
						<name>adcd_dsmdiv_ctrl</name>
						<description>* adcd_dsmdiv_ctrl *</description>
						<addressOffset>0x30</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adcd_dsmdiv_ctrl</name>
								<description>bit3:cfg_upd\nbit2:div2\nbit1:enable_dither\nbit0:enable</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--adcd_dsmdiv_int-->
					<register>
						<name>adcd_dsmdiv_int</name>
						<description>* adcd_dsmdiv_int *</description>
						<addressOffset>0x34</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>adcd_dsmdiv_frac</name>
								<description>nan</description>
								<bitRange>[23:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>adcd_dsmdiv_int</name>
								<description>nan</description>
								<bitRange>[31:24]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--CORE_SPI-->
			<peripheral>
				<name>CORE_SPI</name>
				<version>1.0</version>
				<description>CORE_SPI</description>
				<groupName>CORE_SPI</groupName>
				<baseAddress>0x8800</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x60</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--spi_ctrl-->
					<register>
						<name>spi_ctrl</name>
						<description>* spi_ctrl *</description>
						<addressOffset>0x0</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>spi_en</name>
								<description>spi enable\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_hw_start_en</name>
								<description>dcmi multi-line interrup\nt start spi.\n0: disable hardware strat sp\ni.\n1: enable hardware strat spi\n.</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_hw_start_sel</name>
								<description>dcmi multi-line interrup\nt select.\n0: dcmi dma0.\n1: dcmi dma1.</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_start</name>
								<description>spi start signal. after \nwriting '1', the hardware st\narts spi send and receive on\nce.</description>
								<bitRange>[3:3]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>cpol</name>
								<description>the clock polarity.\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>cpha</name>
								<description>the clock phase.\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_rx_seq</name>
								<description>transceiver sequence con\ntrol.\n0: sends and receives packet\ns simultaneously. the length\n is tx_len.\n1: first tx_len's sends (ski\nps send when tx_len is 0), a\nnd then rx_len's receives (s\nkips receive when rx_len is \n0).</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_adj_en</name>
								<description>enable switch of receivi\nng phase adjustment.</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>ncs_dly</name>
								<description>ncs pulls down in advanc\ne and pulls up with lag:\nspi_clk*(ncs_dly+1).</description>
								<bitRange>[10:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>fifo_sw_en</name>
								<description>enable fifo software con\ntrol permissions.\n0: software cannot operate f\nifo, only dma automatic oper\nation is run.\n1: software can operate fifo\n for transceiver directly, d\no not use dma.</description>
								<bitRange>[11:11]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>trx_dly</name>
								<description>master mode (slave mode \n= 0):\nsend and receive protection \ninterval:\nspi_clk*(trx_dly+1)*4.\nslave mode (slave mode = 1):\ntrx_dly[0]: slv_tx_en, '1' e\nnable slave transmit, else d\nisable\ntrx_dly[1]: slv_rx_en, '1' e\nnable slave receive, else di\nsable\ntrx_dly[2]: slv_nss_sel, '1'\n slave nss use slv_nss_sw, e\nlse use hardware nss from gp\nio (function spi_nss)\ntrx_dly[3]: slv_nss_sw, soft\nware controlled slave nss va\nlue</description>
								<bitRange>[15:12]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>clk_div</name>
								<description>clock frequency division\n, the frequency division val\nue is:\n(clk_div + 1)*2.</description>
								<bitRange>[19:16]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_adj_clk</name>
								<description>receive phase adjustment\n value, the sampling time is\n delayed:\n(rx_adj_clk + 1)*spi_clk clo\nck cycles, not greater than \nclk_div.</description>
								<bitRange>[23:20]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>slave_mode</name>
								<description>slave mode select\n0: master mode\n1: slave mode</description>
								<bitRange>[24:24]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>y_to_rgb_mode</name>
								<description>1: the buffer content is\n 8-bit gray, which is automa\ntically converted to 16-bit \nrgb565 during actual sending\n.</description>
								<bitRange>[25:25]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>lsb_first_mode</name>
								<description>1: lsb transmit first\n0: msb transmit first\nnote: when y_to_rgb_mode is \n1, y is converted to rgb fir\nst, and then sent in the seq\nuence of configured bits.\nthis bit also take affect in\n slave mode</description>
								<bitRange>[26:26]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>mram_sel</name>
								<description>mram select\n1: use mram as dma ram</description>
								<bitRange>[27:27]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>bidi_mode</name>
								<description>half-duplex mode control\n1: half-duplex mode enable\n0: half-duplex mode disabled\nnote:\n1) take affect in both maste\nr mode and slave mode\n2) in master mode, using mos\ni as bi-direction data lane\n3) in slave mode, using miso\n as bi-direction data lane</description>
								<bitRange>[28:28]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>bidi_oe</name>
								<description>half-duplex output enabl\ne control\n0: data lane output disabled\n and used as data input\n1: data lane output enable\nnote: this bit only take aff\nect in slave mode</description>
								<bitRange>[29:29]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>bit9_mode</name>
								<description>1: rx data 2:tx cmd(0) 3\n:tx data(1)</description>
								<bitRange>[31:30]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--spi_ie-->
					<register>
						<name>spi_ie</name>
						<description>* spi_ie *</description>
						<addressOffset>0x10</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>dma_done_ie</name>
								<description>dma done interrupt enabl\ne\n1: enable\n0: disable</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_fifo_lo_ie</name>
								<description>tx fifo low interrupt en\nable\n1: enable\n0: disable</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_fifo_ovfl_ie</name>
								<description>tx fifo overflow interru\npt enable\n1: enable\n0: disable</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_fifo_hi_ie</name>
								<description>rx fifo high interrupt e\nnable\n1: enable\n0: disable</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_fifo_ovfl_ie</name>
								<description>rx fifo overflow interru\npt enable\n1: enable\n0: disable</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>start_over_quick_ie</name>
								<description>start over quick interru\npt enable\n1: enable\n0: disable</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_empty_ie</name>
								<description>tx data empty interrupt \nenable\n1: enable\n0: disable\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_not_empty_ie</name>
								<description>rx data not empty interr\nupt enable\n1: enable\n0: disable\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_overrun_ie</name>
								<description>rx data overrun interrup\nt enable\n1: enable\n0: disable\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[8:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_ie_reserved</name>
								<description>reserved</description>
								<bitRange>[31:9]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_ris-->
					<register>
						<name>spi_ris</name>
						<description>* spi_ris *</description>
						<addressOffset>0x14</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>dma_done_ris</name>
								<description>dma_done raw interrupt s\ntatus\n1: one spi transceive task f\ninish</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_fifo_lo_ris</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_fifo_ovfl_ris</name>
								<description>nan</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_fifo_hi_ris</name>
								<description>nan</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_fifo_ovfl_ris</name>
								<description>nan</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>start_over_quick_ris</name>
								<description>when the spi start signa\nl comes, the last transmissi\non has not been completed. a\nt this time, an spi task wil\nl be missed and an error wil\nl occur.</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_empty_ris</name>
								<description>tx data register empty i\nnterrupt status\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[6:6]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_not_empty_ris</name>
								<description>rx data register not emp\nty interrupt status\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[7:7]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_overrun_ris</name>
								<description>rx data register overrun\n interrupt status\nwhen rx_not_empty is '1', me\nans one byte had been receiv\ned but do not read by softwa\nre or fifo, a new byte is re\nceived, then rx_overrun_ris \nwill assert.\nnote:\n1) this bit also take affect\n in slave mode\n2) newly received data will \nbe ignored</description>
								<bitRange>[8:8]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>spi_ris_reserved</name>
								<description>reserved</description>
								<bitRange>[31:9]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_mis-->
					<register>
						<name>spi_mis</name>
						<description>* spi_mis *</description>
						<addressOffset>0x18</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>dma_done_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>tx_fifo_lo_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis</description>
								<bitRange>[1:1]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>tx_fifo_ovfl_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis</description>
								<bitRange>[2:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_fifo_hi_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis</description>
								<bitRange>[3:3]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_fifo_ovfl_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis</description>
								<bitRange>[4:4]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>start_over_quick_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis</description>
								<bitRange>[5:5]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>tx_empty_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[6:6]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_not_empty_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[7:7]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_overrun_mis</name>
								<description>masked interrupt status\nmis = ris &amp; ie, clear ris wi\nll clear responding mis\nnote: this bit also take aff\nect in slave mode</description>
								<bitRange>[8:8]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>spi_mis_reserved</name>
								<description>reserved</description>
								<bitRange>[31:9]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_dr-->
					<register>
						<name>spi_dr</name>
						<description>* spi_dr *</description>
						<addressOffset>0x20</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>spi_dr</name>
								<description>data register\nwhen read, get received data\n byte, and clear rx_not_empt\ny\nwhen write, store data byte \nto transmit register, and cl\near tx_empty\nnote: spi_dr only take affec\nt in slave mode</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_dr_reserved</name>
								<description>reserved</description>
								<bitRange>[31:8]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_fifo-->
					<register>
						<name>spi_fifo</name>
						<description>* spi_fifo *</description>
						<addressOffset>0x30</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tx_fifo_rd</name>
								<description>write '1' will read a by\nte out of tx_fifo\nnote: only take affect when \nfifo_sw_en '1'</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>tx_fifo_empty</name>
								<description>tx fifo empty.</description>
								<bitRange>[1:1]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>tx_fifo_full</name>
								<description>tx fifo full.</description>
								<bitRange>[2:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>fifo_rst_sw</name>
								<description>software resets the fifo\n.\n0: do not effect.\n1: reset fifo.</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>slv_fifo_en</name>
								<description>1: enable fifo for slave\n mode</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_fifo_reserved</name>
								<description>reserved</description>
								<bitRange>[7:5]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_fifo_rd</name>
								<description>write '1' will read a by\nte out of rx_fifo\nnote: only take affect when \nfifo_sw_en '1'</description>
								<bitRange>[8:8]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>rx_fifo_empty</name>
								<description>rx fifo empty.</description>
								<bitRange>[9:9]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_fifo_full</name>
								<description>rx fifo full.</description>
								<bitRange>[10:10]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>fifo_rst_auto</name>
								<description>the fifo automatically r\nesets.\n0: do not effect.\n1: after each transmission i\ns completed, automatically r\neset the fifo.</description>
								<bitRange>[11:11]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_fifo_reserved</name>
								<description>reserved</description>
								<bitRange>[15:12]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>first_byte_rsv_bits</name>
								<description>first byte reserved bits\n, 0 to 7 represents 0 to 7 r\neserved bits\nnote: \n1)  this field enables non-b\nyte aligned command transmit\n2) the first byte is send ms\nb first or lsb first accordi\nng to lsb_first_mode\n3) when msb send first, rese\nrved bits are aligned to lsb\n, else otherwise \n4) this field only active in\n master mode</description>
								<bitRange>[18:16]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_fifo_reserved1</name>
								<description>reserved</description>
								<bitRange>[31:19]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_fifo_ctrl-->
					<register>
						<name>spi_fifo_ctrl</name>
						<description>* spi_fifo_ctrl *</description>
						<addressOffset>0x34</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tx_fifo_waterlevel</name>
								<description>tx fifo low waterline. i\nf the length of the sent fif\no data is less than or equal\n to this length and the valu\ne of the waterline is not 0,\n the tx_fifo_lo interrupt is\n triggered.</description>
								<bitRange>[4:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_fifo_ctrl_reserved</name>
								<description>reserved</description>
								<bitRange>[7:5]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_fifo_waterlevel</name>
								<description>rx fifo low waterline. i\nf the length of the sent fif\no data is greater than or eq\nual to this length and the v\nalue of the waterline is not\n 0, the rx_fifo_hi interrupt\n is triggered.</description>
								<bitRange>[12:8]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_fifo_ctrl_reserved1</name>
								<description>reserved</description>
								<bitRange>[15:13]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>tx_fifo_items</name>
								<description>nan</description>
								<bitRange>[20:16]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>spi_fifo_ctrl_reserved2</name>
								<description>reserved</description>
								<bitRange>[23:21]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>rx_fifo_items</name>
								<description>nan</description>
								<bitRange>[28:24]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>spi_fifo_ctrl_reserved3</name>
								<description>reserved</description>
								<bitRange>[31:29]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_tx_fifo-->
					<register>
						<name>spi_tx_fifo</name>
						<description>* spi_tx_fifo *</description>
						<addressOffset>0x38</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tx_fifo_data</name>
								<description>read and write operation\n only take affect when fifo_\nsw_en '1'\nwhen write, the byte is dire\nctly written to the tx_fifo;\n when read, indicate the cur\nrent value of tx_fifo.</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>tx_fifo_reserved</name>
								<description>reserved</description>
								<bitRange>[31:8]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_rx_fifo-->
					<register>
						<name>spi_rx_fifo</name>
						<description>* spi_rx_fifo *</description>
						<addressOffset>0x3c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rx_fifo_data</name>
								<description>read and write operation\n only take affect when fifo_\nsw_en '1'\nwhen write, the byte is dire\nctly written to the rx_fifo;\n whenread, indicate the curr\nent value of rx_fifo.</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_fifo_reserved</name>
								<description>reserved</description>
								<bitRange>[31:8]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_dma-->
					<register>
						<name>spi_dma</name>
						<description>* spi_dma *</description>
						<addressOffset>0x40</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>dma_en</name>
								<description>dma enable\n1: enable dma, dma will move\n data from ram to tx_fifo wh\nen tx_fifo not full, and mov\ne data from rx_fifo to ram w\nhen rx_fifo not empty</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dma_start_auto</name>
								<description>1: spi_start starts dma \nautomatically without manual\n start.\n0: dma does not start automa\ntically and must be started \nmanually through dma_start_m\nan.</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_dma_reserved</name>
								<description>reserved</description>
								<bitRange>[2:2]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>dma_start_man</name>
								<description>write 1 starts a dma tra\nnsfer task.</description>
								<bitRange>[3:3]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>tx_fixed_addr</name>
								<description>0: tx_addr auto-incremen\nt.\n1: tx_addr fixed.</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rx_fixed_addr</name>
								<description>0: rx_addr auto-incremen\nt.\n1: rx_addr fixed.</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>dma_pingpang_en</name>
								<description>when spi sent data, dma \nfetched the data from the pi\nngpang buffer.\n0: disable pingpang.\n1: enable pingpang，tx_saddr~\ntx_saddr+tx_len和tx_saddr+tx_\nlen ~ tx_saddr+tx_len*2.</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_dma_reserved1</name>
								<description>reserved</description>
								<bitRange>[15:7]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>dma_status</name>
								<description>[20]: pingpang_reg, 0: p\ningpang0, 1: pingpang 1\n[18:16]: dma fsm, 0: idle, 1\n: pull_tx_buf, 2: read ram, \n3: poll_rx_buf, 4: write ram\n, 5: dma_done</description>
								<bitRange>[23:16]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>spi_status</name>
								<description>[31]: slv_spi_busy, 1: b\nyte proc, 0: idle\n[26:24]: master fsm, 0: idle\n, 1: ncs_low, 2: data_byte, \n3: trx_dly, 4: wait_buf, 5: \nncs_high</description>
								<bitRange>[31:24]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_dma_tx_addr-->
					<register>
						<name>spi_dma_tx_addr</name>
						<description>* spi_dma_tx_addr *</description>
						<addressOffset>0x44</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tx_addr</name>
								<description>current sending address.</description>
								<bitRange>[17:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>spi_dma_tx_addr_reserved</name>
								<description>reserved</description>
								<bitRange>[31:18]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_dma_rx_addr-->
					<register>
						<name>spi_dma_rx_addr</name>
						<description>* spi_dma_rx_addr *</description>
						<addressOffset>0x48</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rx_addr</name>
								<description>current receiving addres\ns.</description>
								<bitRange>[17:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>spi_dma_rx_addr_reserved</name>
								<description>reserved</description>
								<bitRange>[31:18]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_dma_tx_saddr-->
					<register>
						<name>spi_dma_tx_saddr</name>
						<description>* spi_dma_tx_saddr *</description>
						<addressOffset>0x50</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tx_start_addr</name>
								<description>tx start addr.</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_dma_tx_saddr_reserved</name>
								<description>reserved</description>
								<bitRange>[31:18]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_dma_rx_saddr-->
					<register>
						<name>spi_dma_rx_saddr</name>
						<description>* spi_dma_rx_saddr *</description>
						<addressOffset>0x54</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rx_start_addr</name>
								<description>rx start addr.</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_dma_rx_saddr_reserved</name>
								<description>reserved</description>
								<bitRange>[31:18]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_dma_tx_len-->
					<register>
						<name>spi_dma_tx_len</name>
						<description>* spi_dma_tx_len *</description>
						<addressOffset>0x58</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>tx_len</name>
								<description>tx length.</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_dma_tx_len_reserved</name>
								<description>reserved</description>
								<bitRange>[31:18]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--spi_dma_rx_len-->
					<register>
						<name>spi_dma_rx_len</name>
						<description>* spi_dma_rx_len *</description>
						<addressOffset>0x5c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rx_len</name>
								<description>rx length.</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>spi_dma_rx_len_reserved</name>
								<description>reserved</description>
								<bitRange>[31:18]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--RF_BBPLL-->
			<peripheral>
				<name>RF_BBPLL</name>
				<version>1.0</version>
				<description>RF_BBPLL</description>
				<groupName>RF_BBPLL</groupName>
				<baseAddress>0x8a00</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0xf</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--bbpll_ctrl0-->
					<register>
						<name>bbpll_ctrl0</name>
						<description>* bbpll_ctrl0 *</description>
						<addressOffset>0x0</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>da_bbpll_ring_en</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_pfd_en</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_cp_en</name>
								<description>nan</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rg_ldo_bbpll_vctrl</name>
								<description>1.05/1.1/1.15/1.2v</description>
								<bitRange>[4:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_ldo_bbpll_ibleed</name>
								<description>30ua per step from 0</description>
								<bitRange>[6:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_ldo_bbpll_en</name>
								<description>nan</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bbpll_ctrl1-->
					<register>
						<name>bbpll_ctrl1</name>
						<description>* bbpll_ctrl1 *</description>
						<addressOffset>0x1</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>da_bbpll_ck2sar_48m_en</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_ck2dig_192m_en</name>
								<description>nan</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_ck2dig_256m_en</name>
								<description>nan</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_ck2dig_384m_en</name>
								<description>nan</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_logen_en</name>
								<description>nan</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_fbdiv_rstn</name>
								<description>nan</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_fbdiv_en</name>
								<description>nan</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_bbpll_logen_rstn</name>
								<description>nan</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bbpll_div_int-->
					<register>
						<name>bbpll_div_int</name>
						<description>* bbpll_div_int *</description>
						<addressOffset>0x2</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>da_bbpll_fbdiv_intn</name>
								<description>connect to module: divr_\nin</description>
								<bitRange>[6:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bbpll_div_frac-->
					<register>
						<name>bbpll_div_frac</name>
						<description>* bbpll_div_frac *</description>
						<addressOffset>0x4</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>da_bbpll_fbdiv_frac</name>
								<description>nan</description>
								<bitRange>[19:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--bbpll_sdm-->
					<register>
						<name>bbpll_sdm</name>
						<description>* bbpll_sdm *</description>
						<addressOffset>0x8</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rg_bbpll_sdm_mash_order_sel</name>
								<description>connect to module: mash_\norder_sel</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
