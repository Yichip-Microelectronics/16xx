					<!--filter3_code-->
					<register>
						<name>filter3_code</name>
						<description>* filter3_code *</description>
						<addressOffset>0xa8</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filter3_code</name>
								<description>filter group 3 first ide\nntifier.</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--filter3_mask-->
					<register>
						<name>filter3_mask</name>
						<description>* filter3_mask *</description>
						<addressOffset>0xac</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>filter3_mask</name>
								<description>filter group 3 second id\nentifier.</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--PLIC_RV_INT-->
			<peripheral>
				<name>PLIC_RV_INT</name>
				<version>1.0</version>
				<description>PLIC_RV_INT</description>
				<groupName>PLIC_RV_INT</groupName>
				<baseAddress>0x8E00</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x69</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--rv_irq_prio-->
					<register>
						<dim>8</dim>
						<dimIncrement>1</dimIncrement>
						<name>rv_irq_prio[%s]</name>
						<description>* rv_irq_prio *</description>
						<addressOffset>0x0</addressOffset>
						<size>8</size>
					</register>
					<!--rv_irq_enab-->
					<register>
						<name>rv_irq_enab</name>
						<description>* rv_irq_enab *</description>
						<addressOffset>0x8</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rv_irq_enab</name>
								<description>riscv interrupt enable b\nit</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rv_irq_thrd-->
					<register>
						<name>rv_irq_thrd</name>
						<description>* rv_irq_thrd *</description>
						<addressOffset>0xc</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rv_irq_thrd</name>
								<description>riscv interrupt priority\n threshold</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rv_irq_pend-->
					<register>
						<name>rv_irq_pend</name>
						<description>* rv_irq_pend *</description>
						<addressOffset>0x40</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rv_irq_pend</name>
								<description>riscv interrupt pending \nstatus</description>
								<bitRange>[31:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--rv_irq_clam-->
					<register>
						<name>rv_irq_clam</name>
						<description>* rv_irq_clam *</description>
						<addressOffset>0x64</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rv_irq_clam</name>
								<description>the interrupt claim id, \nwrite the id to clear the in\nterrupt</description>
								<bitRange>[4:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rv_irq_nirq-->
					<register>
						<name>rv_irq_nirq</name>
						<description>* rv_irq_nirq *</description>
						<addressOffset>0x68</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rv_irq_nirq</name>
								<description>riscv interrupt new irq</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--LPM_CONTROL-->
			<peripheral>
				<name>LPM_CONTROL</name>
				<version>1.0</version>
				<description>LPM_CONTROL</description>
				<groupName>LPM_CONTROL</groupName>
				<baseAddress>0x9f00</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x20</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--enon_ctrl-->
					<register>
						<name>enon_ctrl</name>
						<description>* enon_ctrl *</description>
						<addressOffset>0x0</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>osc_xtal_en_reg_on</name>
								<description>enable controls for acti\nve mode</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>osc_xtal_en_on</name>
								<description>enable controls for acti\nve mode</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>osc_rc_en_on</name>
								<description>enable controls for acti\nve mode</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_ldo_dig_core_en_on</name>
								<description>enable controls for acti\nve mode</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>osc_xtal_en_reg_lpm</name>
								<description>enable control for lpm m\node</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>osc_xtal_en_lpm</name>
								<description>enable control for lpm m\node</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>osc_rc_en_lpm</name>
								<description>enable control for lpm m\node</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>da_ldo_dig_core_en_lpm</name>
								<description>enable control for lpm m\node</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--buck_oe-->
					<register>
						<name>buck_oe</name>
						<description>* buck_oe *</description>
						<addressOffset>0x4</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>buck_oe</name>
								<description>1=bucken output is enabl\ned when wakeup/sleep</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>exen_oe</name>
								<description>1=exbucken output is ena\nbled when wakeup/sleep</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>core_porn_rst_en</name>
								<description>1=enable core_porn reset\n core when core_porn = 0</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>vio33_pgood_rst_en</name>
								<description>1=enable vio33_pgood res\net core when vio33_pgood =0</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[5:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>fast wake</name>
								<description>1=gpio/comparator wake u\np after exen counter\n0=set larger value of exen/x\ntal counter at gpio wakeup</description>
								<bitRange>[6:6]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>cold wake </name>
								<description>1=clear memory/load otp/\nload eeprom at wakeup</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--digldo_cnt-->
					<register>
						<name>digldo_cnt</name>
						<description>* digldo_cnt *</description>
						<addressOffset>0x5</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>digldo_cnt</name>
								<description>digital ldo is power on \nwhen counter is less than th\nis value\ndefault set to 0 for first p\nower up, set to 0x14 for sle\nep&amp;wakeup process</description>
								<bitRange>[4:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rco_cnt</name>
								<description>nan</description>
								<bitRange>[7:5]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--xtal_cnt-->
					<register>
						<name>xtal_cnt</name>
						<description>* xtal_cnt *</description>
						<addressOffset>0x6</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>xtal_cnt</name>
								<description>crystal is power on when\n counter is less than this v\nalue\ndefault set to 0 for first p\nower up, set to 0x3f for sle\nep&amp;wakeup process</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--exen_cnt-->
					<register>
						<name>exen_cnt</name>
						<description>* exen_cnt *</description>
						<addressOffset>0x7</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>exen_cnt</name>
								<description>buck enable is on when c\nounter is less than this val\nue\ndefault set to 0 for first p\nower up, set to 0xff for sle\nep&amp;wakeup process</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--ice_mode  -->
					<register>
						<name>ice_mode  </name>
						<description>* ice_mode   *</description>
						<addressOffset>0x8</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ice_mode  </name>
								<description>ice/gpio mux select</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>wd_en</name>
								<description>riscv watch dog enable</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>code_crc_check_en</name>
								<description>code data check crc afte\nr read from flash enable</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>io_rst_en</name>
								<description>gpio &amp; touch long press \nreset enable</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>xtal_en</name>
								<description>xtal enable( default dis\nable for power save)</description>
								<bitRange>[4:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>wk_gpio_mode</name>
								<description>nan</description>
								<bitRange>[5:5]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--go2sleep_wr-->
					<register>
						<name>go2sleep_wr</name>
						<description>* go2sleep_wr *</description>
						<addressOffset>0x9</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>go2sleep_wr</name>
								<description>nan</description>
								<bitRange>[0:0]</bitRange>
								<access>write-only</access>
							</field>
						</fields>
					</register>
					<!--lpm_xo32k_sel-->
					<register>
						<name>lpm_xo32k_sel</name>
						<description>* lpm_xo32k_sel *</description>
						<addressOffset>0xa</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>lpm_xo32k_sel</name>
								<description>0:rc32k 1:xtal 32k</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--lpm_wreg-->
					<register>
						<name>lpm_wreg</name>
						<description>* lpm_wreg *</description>
						<addressOffset>0xc</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>lpm_wreg</name>
								<description>value to be written to t\nhe lpm counter</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--pad latch-->
					<register>
						<name>pad latch</name>
						<description>* pad latch *</description>
						<addressOffset>0x10</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>pad latch</name>
								<description>1=latch all gpio's previ\nous state </description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--icache_retry_num-->
					<register>
						<name>icache_retry_num</name>
						<description>* icache_retry_num *</description>
						<addressOffset>0x11</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>icache_retry_num</name>
								<description>cache line retry read nu\nm when cache line crc error\nactive only when code_crc_ch\neck_en = 1</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--host_wakeup-->
					<register>
						<name>host_wakeup</name>
						<description>* host_wakeup *</description>
						<addressOffset>0x12</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>host_wakeup</name>
								<description>host wakeup status for d\nebug</description>
								<bitRange>[0:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>flag_wakeup</name>
								<description>gpio rtc0 rtc1 rtcov puw\nk</description>
								<bitRange>[5:1]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--ucode_flag-->
					<register>
						<name>ucode_flag</name>
						<description>* ucode_flag *</description>
						<addressOffset>0x14</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>ucode_flag</name>
								<description>nan</description>
								<bitRange>[3:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>device_option</name>
								<description>nan</description>
								<bitRange>[7:4]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--sw_used-->
					<register>
						<name>sw_used</name>
						<description>* sw_used *</description>
						<addressOffset>0x17</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>sw_used</name>
								<description>reserved for sw use</description>
								<bitRange>[7:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--lpm_pc-->
					<register>
						<name>lpm_pc</name>
						<description>* lpm_pc *</description>
						<addressOffset>0x18</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>lpm_pc</name>
								<description>pc value when leaving lp\nm mode</description>
								<bitRange>[23:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--lpm_sp-->
					<register>
						<name>lpm_sp</name>
						<description>* lpm_sp *</description>
						<addressOffset>0x1c</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>lpm_sp</name>
								<description>sp value when leaving lp\nm mode</description>
								<bitRange>[17:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
			<!--LPM_PUWAKEUP-->
			<peripheral>
				<name>LPM_PUWAKEUP</name>
				<version>1.0</version>
				<description>LPM_PUWAKEUP</description>
				<groupName>LPM_PUWAKEUP</groupName>
				<baseAddress>0x9f20</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x17</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--puchk-->
					<register>
						<name>puchk</name>
						<description>* puchk *</description>
						<addressOffset>0x0</addressOffset>
						<size>8</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>key_delay</name>
								<description>wait after output low fo\nr key scan,0=1, 1=2, 2=4, 3=\n8 lpo clocks</description>
								<bitRange>[1:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>pu_delay</name>
								<description>wait after pullup for wh\neel,0=1, 1=2, 2=4, 3=8 lpo c\nlocks</description>
								<bitRange>[3:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>interval</name>
								<description>interval between wakeup \ndetects, 1=8,2=16,..7=1024 l\npo clocks</description>
								<bitRange>[6:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>enable</name>
								<description>dynamic gpio wakeup enab\nle</description>
								<bitRange>[7:7]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--key_det-->
					<register>
						<name>key_det</name>
						<description>* key_det *</description>
						<addressOffset>0x2</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>key_detected</name>
								<description>t scan key detected:\n{i,index[5:0]}</description>
								<bitRange>[11:0]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>pu_wakeup</name>
								<description>puwakeup module is waked\n up</description>
								<bitRange>[12:12]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--gpio_wake_cfg-->
					<register>
						<dim>19</dim>
						<dimIncrement>1</dimIncrement>
						<name>gpio_wake_cfg[%s]</name>
						<description>* gpio_wake_cfg *</description>
						<addressOffset>0x4</addressOffset>
						<size>8</size>
					</register>
				</registers>
			</peripheral>
			<!--LPM_RTC-->
			<peripheral>
				<name>LPM_RTC</name>
				<version>1.0</version>
				<description>LPM_RTC</description>
				<groupName>LPM_RTC</groupName>
				<baseAddress>0x9f50</baseAddress>
				<addressBlock>
					<offset>0</offset>
					<size>0x10</size>
					<usage>registers</usage>
				</addressBlock>
				<registers>
					<!--rtc_ov_en-->
					<register>
						<name>rtc_ov_en</name>
						<description>* rtc_ov_en *</description>
						<addressOffset>0x0</addressOffset>
						<size>16</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rtc_ov_en</name>
								<description>enable rtc overflow inte\nrrupt\nneed 2~3 cycles of 32khz tim\ne to be valid</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rtc_comp0_en</name>
								<description>enable rtc comp0 interru\npt\nneed 2~3 cycles of 32khz tim\ne to be valid</description>
								<bitRange>[1:1]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rtc_comp1_en</name>
								<description>enable rtc comp1 interru\npt</description>
								<bitRange>[2:2]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rtc_enable</name>
								<description>rtc enable\nneed 2~3 cycles of 32khz tim\ne to be valid</description>
								<bitRange>[3:3]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>rtc_wk_en</name>
								<description>enable rtc interrupt wak\neup the system\nneed 2~3 cycles of 32khz tim\ne to be valid\nbit0 : enable rtc_intr0 wake\nup the system\nbit1: enable rtc_intr1 wakeu\np the system\nbit2: enable rtc_ov_intr wak\neup the system</description>
								<bitRange>[6:4]</bitRange>
								<access>read-write</access>
							</field>
							<field>
								<name>reserved1</name>
								<description>reserved</description>
								<bitRange>[7:7]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>rtc_ovwr_cmd</name>
								<description>overwrite rtc to 0xffff_\nff00 to test rtc overflow in\nt</description>
								<bitRange>[8:8]</bitRange>
								<access>write-only</access>
							</field>
							<field>
								<name>reserved2</name>
								<description>reserved</description>
								<bitRange>[12:9]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>intr_rtc_ov</name>
								<description>rtc overflow interrupt</description>
								<bitRange>[13:13]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>intr_rtc0</name>
								<description>rtc interrupt 0</description>
								<bitRange>[14:14]</bitRange>
								<access>read-only</access>
							</field>
							<field>
								<name>intr_rtc1</name>
								<description>rtc interrupt 1</description>
								<bitRange>[15:15]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<!--rtc_comp0-->
					<register>
						<name>rtc_comp0</name>
						<description>* rtc_comp0 *</description>
						<addressOffset>0x4</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rtc_comp0</name>
								<description>rtc compare0 \nif change the cfg, disable r\ntc_comp0_en first</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rtc_comp1-->
					<register>
						<name>rtc_comp1</name>
						<description>* rtc_comp1 *</description>
						<addressOffset>0x8</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rtc_comp1</name>
								<description>rtc compare1\nif change the cfg, disable r\ntc_comp1_en first</description>
								<bitRange>[31:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<!--rtc_cnt-->
					<register>
						<name>rtc_cnt</name>
						<description>* rtc_cnt *</description>
						<addressOffset>0xc</addressOffset>
						<size>32</size>
						<resetValue>0x00000000</resetValue>
						<fields>
							<field>
								<name>rtc_cnt</name>
								<description>rtc current counter\nread twice and check the val\nue to avoid uncertainty or r\nead at the rising edge of lp\no_clk</description>
								<bitRange>[31:0]</bitRange>
								<access>read-only</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
