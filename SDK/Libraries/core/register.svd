							<field>
								<name>rom_csn_mode</name>
								<description>0:follow clken   1:alway\ns 0</description>
								<bitRange>[0:0]</bitRange>
								<access>read-write</access>
							</field>
						</fields>
					</register>
				</registers>
			</peripheral>
